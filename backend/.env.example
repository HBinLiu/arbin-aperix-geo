# --- 应用 ---
# 复制为实际环境文件后填写（勿提交含密钥的文件）：
#   cp .env.example .env.development   # 本地
#   cp .env.example .env.production    # 生产；启动前 export ENV=production
# ENV=development
# API_HOST=0.0.0.0
# API_PORT=8000
# OTP_CODE_TTL_SECONDS=300
# OTP_SEND_INTERVAL_SECONDS=60
# favicon 本地缓存目录（按域名子目录；成功抓取后才有文件，默认 data/favicons）
# FAVICON_STORAGE_DIR=/absolute/path/to/favicons

# 第三方 HTTP 客户端日志（httpx 默认 WARNING，避免逐条 GET 刷屏）
# HTTPX_LOG_LEVEL=WARNING

# --- 认证 ---
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ENCRYPT_ALGORITHM=HS256
JWT_TOKEN_EXPIRE_MINUTES=10080

# --- 数据库 ---
DATABASE_URL=postgresql+psycopg://aperix:aperix@127.0.0.1:5432/arbin_aperix_geo

# --- Redis / Celery ---
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2
# CELERY_REDIS_SOCKET_TIMEOUT_S=30
# CELERY_REDIS_CONNECT_TIMEOUT_S=10
# 采样 Celery 分池（默认队列名；分机时各机器 CELERY_WORKER_ROLE=orch|llm|crawl|parse）
# CELERY_DEFAULT_QUEUE=aperix
# CELERY_SAMPLING_LLM_QUEUE=sampling.llm
# CELERY_SAMPLING_CRAWL_QUEUE=sampling.crawl
# CELERY_SAMPLING_PARSE_QUEUE=sampling.parse
# CELERY_ORCH_WORKER_CONCURRENCY=4
# CELERY_LLM_WORKER_CONCURRENCY=16
# CELERY_CRAWL_WORKER_CONCURRENCY=16
# CELERY_PARSE_WORKER_CONCURRENCY=16
# 单机 start_backend.sh：CELERY_SPLIT_WORKERS=1（三分池）；0 或 --unified-worker 为单 worker
# CELERY_SPLIT_WORKERS=1
# 每日采样（北京时间）：02:00 起，在 180 分钟内把各 subject 错开触发，避免同时打满
# SAMPLING_DAILY_HOUR=2
# SAMPLING_DAILY_WINDOW_MINUTES=180
# SAMPLING_SCHEDULER_INTERVAL_MINUTES=15
# SAMPLING_SCHEDULER_MAX_ENQUEUE_PER_RUN=50
# SearXNG 元搜索（可选；采样后开集品牌域名回填；Setup discover 竞品发现走豆包联网）
SEARXNG_BASE_URL=http://127.0.0.1:8080
# SEARXNG_TIMEOUT_S=30
# 单条 response 采样 Celery 重试（指数退避：base, 2*base, …，上限 cap）
# SAMPLING_RETRY_BASE_S=20
# SAMPLING_RETRY_CAP_S=120
# SAMPLING_STALE_JOB_SECONDS=90
# SAMPLING_RESUME_DEBOUNCE_SECONDS=90
# SAMPLING_FILL_DEBOUNCE_SECONDS=1
# SAMPLING_FINALIZE_DEBOUNCE_SECONDS=5
# SAMPLING_LLM_RESULT_CACHE_TTL_S=3600
# SAMPLING_RESPONSE_CLAIM_TTL_S=2700  # 单条 response Redis claim TTL（秒）
# SAMPLING_MAX_INFLIGHT=10  # 每个 job 各 phase 同时进行中的 response 数上限
# SAMPLING_LLM_MAX_INFLIGHT=15  # 各平台同时进行中的 LLM HTTP 请求上限
# SAMPLING_LLM_INFLIGHT_TTL_S=600  # 在飞计数 Redis TTL（worker 异常退出时防泄漏）

# --- 阿里云短信（可选；生产配齐即发 OTP，开发环境仍不发真短信）---
# SMS_ALIYUN_ACCESS_KEY_ID=
# SMS_ALIYUN_ACCESS_KEY_SECRET=
# SMS_ALIYUN_SIGN_NAME=
# SMS_ALIYUN_TEMPLATE_CODE=
# SMS_ALIYUN_TEMPLATE_PARAM_CODE_KEY=code
# SMS_ALIYUN_ENDPOINT=dysmsapi.aliyuncs.com

# --- 邮件（OTP 验证码 + 运维告警共用 SMTP）---
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@example.com
# SMTP_FROM_NAME=Aperix
# SMTP_USE_TLS=true

# --- AI 平台欠费/余额告警（运维邮件）---
# PROVIDER_ALERT_ENABLED=false
# PROVIDER_ALERT_EMAIL_TO=ops@example.com
# PROVIDER_ALERT_COOLDOWN_SECONDS=21600
# PROVIDER_ALERT_MIN_FAILS=3

# --- 大模型 ---
# 火山方舟 · 豆包（DOUBAO_*，Dispatch 采样）
# DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# DOUBAO_API_KEY=
# DOUBAO_MODEL=doubao-seed-1-6-251015
# DOUBAO_RATE_LIMIT_PER_MINUTE=30
# DOUBAO_WEB_SEARCH_ENABLED=true
# DOUBAO_RESPONSES_TIMEOUT_S=120
# 豆包采样路径（默认 api_only = 现网 Ark API；见 docs/09）
# staging 爬虫优先示例：
# DOUBAO_SAMPLING_MODE=crawl_first
# DOUBAO_CRAWL_STORAGE_STATE_PATH=/path/to/doubao_storage_state.json
# DOUBAO_SAMPLING_MODE=api_only
# DOUBAO_CRAWL_TIMEOUT_S=180
# DOUBAO_CRAWL_CONCURRENCY=2
# DOUBAO_CRAWL_HEADLESS=true
# DOUBAO_CRAWL_REQUIRE_SHARE_URL=true
# 冷启动：Playwright storage_state.json（P3 起改账号表）
# DOUBAO_CRAWL_STORAGE_STATE_PATH=
# DOUBAO_CHAT_BASE_URL=https://www.doubao.com/chat/
# DOUBAO_HEARTBEAT_ENABLED=false
# DOUBAO_HEARTBEAT_INTERVAL_MIN=45
# DOUBAO_HEARTBEAT_FRESH_S=21600
# DOUBAO_ACCOUNT_LEASE_TTL_S=300
# DOUBAO_LOGIN_TICKET_ENABLED=false
# DOUBAO_LOGIN_TICKET_TTL_MIN=15
# DOUBAO_LOGIN_NOVNC_BASE_URL=
# DOUBAO_LOGIN_DOCKER_IMAGE=
# 运维 API（/api/v1/ops/doubao/*）；空则 ops 路由 503
# DOUBAO_OPS_API_TOKEN=

# 深度求索 · DeepSeek（DEEPSEEK_*）
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-v4-pro
# DEEPSEEK_WEB_SEARCH_ENABLED=true  # 原生联网，走 Anthropic Messages API，不依赖 SearXNG
# DEEPSEEK_ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
# DEEPSEEK_WEB_SEARCH_TOOL_TYPE=web_search_20250305  # 可选：web_search_20260209（省Token）
# DEEPSEEK_WEB_SEARCH_MAX_USES=5
# DEEPSEEK_CHAT_TIMEOUT_S=120

# 阿里云 · 通义千问（QIANWEN_*）
# QIANWEN_BASE_URL=https://dashscope.aliyuncs.com/api/v1
# QIANWEN_API_KEY=
# QIANWEN_MODEL=qwen-plus
# QIANWEN_RATE_LIMIT_PER_MINUTE=30
# QIANWEN_WEB_SEARCH_ENABLED=true
# QIANWEN_GENERATION_TIMEOUT_S=120

# 腾讯 · 元宝（YUANBAO_*）
# YUANBAO_BASE_URL=https://api.hunyuan.cloud.tencent.com/v1
# YUANBAO_API_KEY=
# YUANBAO_MODEL=hunyuan-turbos-latest
# YUANBAO_RATE_LIMIT_PER_MINUTE=30
# YUANBAO_WEB_SEARCH_ENABLED=true
# YUANBAO_CHAT_TIMEOUT_S=120

# 月之暗面 · Kimi（KIMI_*）
# KIMI_BASE_URL=https://api.moonshot.cn/v1
# KIMI_API_KEY=
# KIMI_MODEL=moonshot-v1-8k
# KIMI_RATE_LIMIT_PER_MINUTE=30
# KIMI_WEB_SEARCH_ENABLED=true
# KIMI_WEB_SEARCH_MAX_USES=5
# KIMI_CHAT_TIMEOUT_S=180
# KIMI_TEMPERATURE=0.6

# 百度 · 文心一言（ERNIE_*）
# ERNIE_BASE_URL=https://qianfan.baidubce.com/v2
# ERNIE_API_KEY=
# ERNIE_MODEL=ernie-4.0-8k
# ERNIE_RATE_LIMIT_PER_MINUTE=30
# ERNIE_WEB_SEARCH_ENABLED=true
# ERNIE_CHAT_TIMEOUT_S=120

# 向量 Embedding（EMBEDDING_*，品牌知识库索引；可与 QIANWEN_API_KEY 复用）
# EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=text-embedding-v4
# EMBEDDING_DIMENSIONS=1024
# EMBEDDING_BATCH_SIZE=25

# 品牌 Setup 上传（会话期 / finalize 持久化）
# SETUP_UPLOAD_DIR=data/setup_uploads
# KNOWLEDGE_UPLOAD_DIR=data/knowledge_uploads

# DNS · dnspython（DNS_*）
# DNS_TIMEOUT_S=1  # 全项目 DNS 查询超时（秒）
# DNS_CACHE_TTL_S=3600  # DNS 解析结果缓存（内存 + Redis）；0=关闭

# 页面抓取 · httpx 优先、Crawl4AI 兜底（PAGE_CRAWL_*）
# PAGE_CRAWL_FETCH_TIMEOUT_S=3  # httpx 单次请求超时（秒）
# PAGE_CRAWL_CRAWL_TIMEOUT_S=10  # Crawl4AI 兜底单次超时（秒）
# PAGE_CRAWL_FALLBACK_ENABLED=true  # httpx 无效时是否回退 Crawl4AI
# PAGE_CRAWL_MAX_CHARS=32000  # 单页抓取正文最大字符数
# PAGE_CRAWL_SEO_MAX_CHARS=64000  # SEO-only 场景（竞品 head、摘要 enrichment）抓取上限
# PAGE_CRAWL_SEO_FALLBACK_ENABLED=false  # SEO-only 场景是否启用 Crawl4AI 兜底（默认关闭）
# PAGE_CRAWL_CONCURRENCY=5  # 批量抓页最大并发数（引用 URL、竞品候选站等）
# PAGE_CRAWL_CRAWL4AI_CONCURRENCY=5  # Crawl4AI 浏览器兜底最大并发（进程内共享）
# PAGE_CRAWL_CACHE_TTL_S=86400  # 同 URL 抓取结果缓存（内存 + Redis）及 job 内引用页元数据去重；0=关闭
# PAGE_CRAWL_NEGATIVE_CACHE_TTL_S=3600  # 抓取失败短缓存，避免死链反复超时；0=关闭
# PAGE_CRAWL_RATE_LIMIT_NEGATIVE_TTL_S=60  # 域名限流跳过时短缓存，避免同 URL 反复撞限流；0=关闭
# PAGE_CRAWL_DOMAIN_LIMIT_PER_MINUTE=30  # 同一 registrable 域名每分钟抓取上限；0=关闭
# PAGE_CRAWL_DOMAIN_MAX_INFLIGHT=3  # 同一域名同时进行中的抓取上限；0=关闭
# PAGE_CRAWL_DOMAIN_LIMIT_WAIT_S=15  # 触发限流时最长等待秒数，超时则跳过本次抓取
# PAGE_CRAWL_DOMAIN_INFLIGHT_TTL_S=600  # 在飞计数 Redis TTL（worker 异常退出时防泄漏）

# 引用来源 · 抓取与 ABSA（CITATION_*）
# CITATION_TEXT_SNIPPET_CHARS=2000  # 引用页正文切片长度（snippet 品牌匹配）
# CITATION_RESPONSE_ABSA_CACHE_TTL_S=86400  # 回复 ABSA 结果缓存（内存 + Redis）；0=关闭
# CITATION_FAVICON_INLINE=false  # true=引用页抓取成功后同步缓存 favicon；false=后台线程

# --- 竞品发现（COMPETITOR_* + DOUBAO_*）---
# 主路径：豆包 Responses API 联网搜竞品；交叉验算 head 走 PAGE_CRAWL_SEO_*。
# SEARXNG_BASE_URL=http://127.0.0.1:8080
# COMPETITOR_POOL_SIZE=30
# COMPETITOR_SEARCH_ROUNDS=3  # 豆包重试轮次上限；未达 RESULT_MIN 时继续调用豆包
# COMPETITOR_CROSS_VALIDATE_BATCH_SIZE=20
# COMPETITOR_CROSS_VALIDATE_PASS_SCORE=6.0
# COMPETITOR_RESULT_MIN=3
# COMPETITOR_RESULT_MAX=5

# --- 设置向导 Redis 会话 ---
# SETUP_SESSION_TTL_S=86400  # 24h；0=永不过期（finalize 成功仍会 DELETE）

# --- 订阅 / 计费（BILLING_*）---
# 支付网关 webhook 鉴权（POST /api/v1/billing/webhook/payment 请求头 X-Billing-Webhook-Secret）
# BILLING_PAY_WEBHOOK_SECRET=change-me-to-a-long-random-string

# --- 微信公众号（服务号扫码绑定，WECHAT_*；与 WECHAT_PAY_* 分开）---
# 服务器配置 URL：https://{api-host}/api/v1/wechat/callback （须公网 HTTPS；本地需内网穿透）
# Token 与下方 WECHAT_TOKEN 一致。AppId/Secret 可与支付同一公众号，但键名分开配置。
# WECHAT_APP_ID=
# WECHAT_APP_SECRET=
# WECHAT_TOKEN=
# WECHAT_AES_KEY=   # 可选；空=明文模式
# WECHAT_BIND_TTL_SECONDS=300
# 模板消息列表见 config/wechat_templates.yaml（templates: [...]）
# WECHAT_TEMPLATES_PATH=config/wechat_templates.yaml
# WECHAT_TEMPLATE_JUMP_BASE_URL=https://app.example.com  # 覆盖 YAML jump_base_url

# --- 微信支付 V3（Native 扫码，WECHAT_PAY_*）---
# 证书/公钥文件放在 certs/wechat/（见该目录 README）
# 商户号、AppID、API v3 密钥（32 字节）、商户 API 证书序列号
# WECHAT_PAY_MCH_ID=
# WECHAT_PAY_APP_ID=
# WECHAT_PAY_API_V3_KEY=
# WECHAT_PAY_MCH_CERT_SERIAL_NO=
# 商户私钥路径（apiclient_key.pem）；微信支付公钥路径（public_key.pem，不是 apiclient_cert）
# WECHAT_PAY_PRIVATE_KEY_PATH=certs/wechat/apiclient_key.pem
# WECHAT_PAY_PUBLIC_KEY_PATH=certs/wechat/public_key.pem
# 微信支付公钥 ID（形如 PUB_KEY_ID_...）
# WECHAT_PAY_PUBLIC_KEY_ID=
# 公网 HTTPS 回调地址（须与商户平台配置一致）
# WECHAT_PAY_NOTIFY_URL=https://api.example.com/api/v1/billing/webhook/wechat
