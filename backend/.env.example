# --- 应用 ---
# ENV=development
# API_HOST=0.0.0.0
# API_PORT=8000
# OTP_CODE_TTL_SECONDS=300
# OTP_SEND_INTERVAL_SECONDS=60
# favicon 本地缓存目录（按域名子目录；成功抓取后才有文件，默认 data/favicons）
# FAVICON_STORAGE_DIR=/absolute/path/to/favicons
# FAVICON_WARM_CONCURRENCY=6  # 采样完成后 favicon 预热并发数（默认 6）

# 第三方 HTTP 客户端日志（httpx 默认 WARNING，避免逐条 GET 刷屏）
# HTTPX_LOG_LEVEL=WARNING

# --- 认证 ---
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ENCRYPT_ALGORITHM=HS256
JWT_TOKEN_EXPIRE_MINUTES=10080

# --- 数据库 ---
DATABASE_URL=postgresql+psycopg://aperix:aperix@127.0.0.1:5432/aperix_geo

# --- Redis / Celery ---
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2
# 定时采样调度 tick 间隔（秒，默认 900 = 15 分钟）
SAMPLING_SCHEDULER_TICK_SECONDS=900
# 采样联网搜索时 SearXNG 每条 prompt 最多取几条结果（须配置 SEARXNG_BASE_URL）
# SAMPLING_SEARXNG_MAX_RESULTS=8
# 单条 response 采样 Celery 重试（指数退避：base, 2*base, …，上限 cap）
# SAMPLING_RETRY_BASE_S=20
# SAMPLING_RETRY_CAP_S=120
# SAMPLING_RETRY_MAX=8
# 开发后门：手动触发一次采样（curl，无需登录；生产务必关闭）
# SAMPLING_DEBUG_ENABLED=true
# SAMPLING_DEBUG_SECRET=change-me-local-only

# --- 阿里云短信（可选）---
# SMS_ALIYUN_ENABLED=false
# SMS_ALIYUN_ACCESS_KEY_ID=
# SMS_ALIYUN_ACCESS_KEY_SECRET=
# SMS_ALIYUN_SIGN_NAME=
# SMS_ALIYUN_TEMPLATE_CODE=
# SMS_ALIYUN_TEMPLATE_PARAM_CODE_KEY=code
# SMS_ALIYUN_ENDPOINT=dysmsapi.aliyuncs.com

# --- 大模型 ---
# 火山方舟 · 豆包（DOUBAO_*，Dispatch 采样）
# DOUBAO_API_KEY=
# DOUBAO_MODEL=doubao-seed-1-6-251015
# DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# DOUBAO_RATE_LIMIT_PER_MINUTE=30
# DOUBAO_WEB_SEARCH_ENABLED=true
# DOUBAO_RESPONSES_TIMEOUT_S=120

# 深度求索 · DeepSeek（DEEPSEEK_*）
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_WEB_SEARCH_ENABLED=true
# DEEPSEEK_CHAT_TIMEOUT_S=120

# 阿里云 · 通义千问（QIANWEN_*）
# QIANWEN_API_KEY=
# QIANWEN_BASE_URL=https://dashscope.aliyuncs.com/api/v1
# QIANWEN_MODEL=qwen-plus
# QIANWEN_RATE_LIMIT_PER_MINUTE=30
# QIANWEN_WEB_SEARCH_ENABLED=true
# QIANWEN_GENERATION_TIMEOUT_S=120

# 腾讯 · 元宝（YUANBAO_*）
# YUANBAO_API_KEY=
# YUANBAO_BASE_URL=https://api.hunyuan.cloud.tencent.com/v1
# YUANBAO_MODEL=hunyuan-turbos-latest
# YUANBAO_RATE_LIMIT_PER_MINUTE=30
# YUANBAO_WEB_SEARCH_ENABLED=true
# YUANBAO_CHAT_TIMEOUT_S=120

# 月之暗面 · Kimi（KIMI_*）
# KIMI_API_KEY=
# KIMI_BASE_URL=https://api.moonshot.cn/v1
# KIMI_MODEL=moonshot-v1-8k
# KIMI_RATE_LIMIT_PER_MINUTE=30
# KIMI_WEB_SEARCH_ENABLED=true
# KIMI_CHAT_TIMEOUT_S=120

# 百度 · 文心一言（ERNIE_*）
# ERNIE_API_KEY=
# ERNIE_BASE_URL=https://qianfan.baidubce.com/v2
# ERNIE_MODEL=ernie-4.0-8k
# ERNIE_RATE_LIMIT_PER_MINUTE=30
# ERNIE_WEB_SEARCH_ENABLED=true
# ERNIE_CHAT_TIMEOUT_S=120

# 页面抓取 · httpx 优先、Crawl4AI 兜底（PAGE_CRAWL_*）
# PAGE_CRAWL_FETCH_TIMEOUT_S=8  # httpx 单次请求超时（秒）
# PAGE_CRAWL_CRAWL_TIMEOUT_S=45  # Crawl4AI 兜底单次超时（秒）
# PAGE_CRAWL_MAX_CHARS=120000  # 单页抓取正文最大字符数
# PAGE_CRAWL_FALLBACK_ENABLED=true  # httpx 无效时是否回退 Crawl4AI
# PAGE_CRAWL_CONCURRENCY=10  # 批量抓页最大并发数（引用 URL、竞品候选站等；竞品多域探测可调高）
# PAGE_CRAWL_CRAWL4AI_CONCURRENCY=5  # Crawl4AI 浏览器兜底最大并发（进程内共享）
# PAGE_CRAWL_CACHE_TTL_S=3600  # 同 URL 抓取结果缓存（内存 + Redis EXAT）；URL 归一化后作 key；内存回填剩余 TTL；0=关闭
# PAGE_CRAWL_NEGATIVE_CACHE_TTL_S=300  # 抓取失败短缓存，避免死链反复超时；0=关闭
# PAGE_CRAWL_DNS_CACHE_TTL_S=3600  # DNS 解析结果缓存（内存 + Redis）；0=关闭

# 引用来源 · Page GEO / ABSA 分析（CITATION_*）
# CITATION_TEXT_SNIPPET_CHARS=4000  # 送入 Page GEO 的正文切片长度
# CITATION_PAGE_GEO_LLM_ENABLED=true  # 是否对引用页跑 Page GEO LLM（关则仅启发式匹配）
# CITATION_PAGE_GEO_BATCH_SIZE=8  # 单次 LLM 请求合并分析的引用页数
# CITATION_PAGE_GEO_CACHE_TTL_S=3600  # Page GEO 结果缓存（内存 + Redis）；0=关闭
# CITATION_RESPONSE_ABSA_CACHE_TTL_S=3600  # ABSA 结果缓存（内存 + Redis）；0=关闭

# --- 竞品发现（COMPETITOR_* + SEARXNG_*）---
SEARXNG_BASE_URL=http://127.0.0.1:8080  # SearXNG 地址（须 json；采样/DeepSeek/Kimi 联网搜索亦依赖此项）
# COMPETITOR_POOL_SIZE=30  # 每轮进入交叉验算的竞品候选主域名上限
# COMPETITOR_SEARCH_ROUNDS=3  # 最多几轮 SearXNG（够 COMPETITOR_RESULT_MIN 个可打开可提前结束）
# COMPETITOR_MIN_SCORE=6.0  # 交叉验算及格分（0–10）
# COMPETITOR_SEARCH_PAGE_SIZE=50  # 每轮 SearXNG 结果条数上限
# COMPETITOR_CROSS_VALIDATE_BATCH_SIZE=15  # 交叉验算每批 LLM 打分数量
# COMPETITOR_RESULT_MIN=3  # 至少几个可打开竞品才停止加搜
# COMPETITOR_RESULT_MAX=5  # 最多返回竞品数
