# noVNC 反代说明（与 GEO_CRAWL_OPS_NOVNC_BASE_URL 配套）
#
# 现状：API spawn 时把容器 6080 映到本机 127.0.0.1:<随机端口>
# 邮件里的 login_url 用 NOVNC_BASE_URL 模板生成，须能转到该端口。
#
# 推荐（同机 Nginx，按端口路径转发）：
#
#   GEO_CRAWL_OPS_NOVNC_BASE_URL=https://ops-novnc.example/p/{port}/vnc.html?autoconnect=1&resize=scale&path=p/{port}/websockify
#
# 下面 Nginx 片段挂在独立子域（建议 IP 白名单 / 仅内网），与 app 同机即可。

# --- nginx ---
# map $http_upgrade $connection_upgrade {
#     default upgrade;
#     ''      close;
# }
#
# server {
#     listen 443 ssl http2;
#     server_name ops-novnc.example;
#     # ssl_certificate ...;
#
#     # 可选：只允许办公网 / VPN
#     # allow 10.0.0.0/8;
#     # deny all;
#
#     location ~ ^/p/(?<novnc_port>[0-9]+)/(?<novnc_rest>.*)$ {
#         proxy_pass http://127.0.0.1:$novnc_port/$novnc_rest$is_args$args;
#         proxy_http_version 1.1;
#         proxy_set_header Host $host;
#         proxy_set_header Upgrade $http_upgrade;
#         proxy_set_header Connection $connection_upgrade;
#         proxy_set_header X-Real-IP $remote_addr;
#         proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
#         proxy_set_header X-Forwarded-Proto $scheme;
#         proxy_read_timeout 3600s;
#         proxy_send_timeout 3600s;
#         proxy_buffering off;
#     }
#
#     location = / {
#         return 204;
#     }
# }

# 验收：
# 1) docker build -t aperix/geo-crawl-ops:latest docker/geo-crawl-ops
# 2) 配好 NOVNC_BASE_URL（含 {port}）+ DOCKER_IMAGE + CALLBACK_BASE_URL
# 3) 开工单后看 ticket.login_url，应类似
#    https://ops-novnc.example/p/60123/vnc.html?autoconnect=1&...&path=p/60123/websockify
# 4) 浏览器打开能看到 Chromium；WebSocket 失败时检查 Upgrade 头与 path 是否带端口前缀
