# docker compose 自动读取本目录 .env（复制本文件为 .env 后修改）
#   cp .env.example .env
#   mkdir -p /var/lib/aperix/crawl-profiles
#   docker compose up -d
#
# 宿主机目录必须与 backend GEO_CRAWL_PROFILE_ROOT 相同。

GEO_WEB_CRAWL_IMAGE=aperix/geo-web-crawl:latest
GEO_WEB_CRAWL_TOKEN=change-me
# ≤ 账号数；与 backend CELERY_CRAWL_WORKER_CONCURRENCY 对齐（同一 profile 不能双开）
GEO_WEB_CRAWL_CONCURRENCY=1
GEO_CRAWL_PROFILE_ROOT=/var/lib/aperix/crawl-profiles
# 常驻 Xvfb + noVNC
GEO_WEB_CRAWL_VNC=true
GEO_WEB_CRAWL_HEADLESS=false
# HTTP：容器监听 / 宿主机映射（backend GEO_WEB_CRAWL_BASE_URL 对 PUBLISH）
GEO_WEB_CRAWL_PORT=9410
GEO_WEB_CRAWL_PUBLISH_PORT=9410
# noVNC：容器监听 / 宿主机映射（工单 {port} = PUBLIC）
GEO_WEB_CRAWL_NOVNC_PORT=6080
GEO_WEB_CRAWL_NOVNC_PUBLIC_PORT=6080
# Prefer Google Chrome (installed in image). Override only if needed.
# GEO_WEB_CRAWL_CHROME_BIN=/usr/bin/google-chrome-stable
# Blunt automation banner / navigator.webdriver (default on)
# GEO_WEB_CRAWL_STEALTH=true
# Chrome --no-sandbox: empty=auto (root / Docker); 1=force; 0=never (local Mac). With sandbox off, --test-type hides the yellow bar.
# GEO_WEB_CRAWL_NO_SANDBOX=
# 与 backend GEO_CRAWL_OPS_NOVNC_BASE_URL 保持一致（工单邮件 / smoke 共用）
# GEO_CRAWL_OPS_NOVNC_BASE_URL=https://ops-novnc.example/p/{port}/vnc.html?autoconnect=1&resize=scale&path=p/{port}/websockify
# Chromium / httpx 出网代理。代理在宿主机时不要写 127.0.0.1，用 host.docker.internal
# HTTP 代理：http://host:port ；SOCKS5（青果 tunpool 常见）必须 socks5://host:port
# HTTP_PROXY=http://host.docker.internal:7890
# HTTPS_PROXY=http://host.docker.internal:7890
# NO_PROXY=localhost,127.0.0.1,host.docker.internal
