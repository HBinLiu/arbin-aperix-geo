# docker compose 自动读取本目录 .env（复制本文件为 .env 后修改）
#   cp .env.example .env
#   mkdir -p /var/lib/aperix/crawl-profiles
#   docker compose up -d
#
# 宿主机目录必须与 backend GEO_CRAWL_PROFILE_ROOT 相同（ops VNC 与爬虫共用 Chrome 用户目录）。

GEO_WEB_CRAWL_IMAGE=aperix/geo-web-crawl:latest
GEO_WEB_CRAWL_TOKEN=Hp2SKSrnrJr8PHCAQ9Qe7aaAszaYKxRm
# ≤ 账号数；与 backend CELERY_CRAWL_WORKER_CONCURRENCY 对齐（同一 profile 不能双开）
GEO_WEB_CRAWL_CONCURRENCY=1
GEO_CRAWL_PROFILE_ROOT=/var/lib/aperix/crawl-profiles
