# docker compose 自动读取本目录 .env（复制本文件为 .env 后修改）
#   cp .env.example .env
#   docker compose up -d
#
# 开启实时看浏览器：LIVE_VIEW=1 + PAUSE；截图仅 start/end（勿依赖连拍）
# 正式采样请 LIVE_VIEW=0。开源 Browserless 通常无 liveURL，用 http://127.0.0.1:3001 Debugger。
#   docker compose up -d --force-recreate

# --- Browserless ---
BROWSERLESS_TOKEN=arbin_aperix_geo_crawl
BROWSERLESS_HOST_PORT=3001
BROWSERLESS_CONCURRENT=4
BROWSERLESS_QUEUED=8
BROWSERLESS_TIMEOUT_MS=600000

# --- geo-web-crawl ---
GEO_WEB_CRAWL_IMAGE=aperix/geo-web-crawl:latest
GEO_WEB_CRAWL_TOKEN=Hp2SKSrnrJr8PHCAQ9Qe7aaAszaYKxRm
GEO_WEB_CRAWL_CONCURRENCY=2

# --- Live view（调试用；生产日常保持 0）---
# 1=开：尝试 liveURL + 可选截图；会按 PAUSE_S 卡住任务开头
GEO_WEB_CRAWL_LIVE_VIEW=0
GEO_WEB_CRAWL_LIVE_VIEW_PAUSE_S=0
# 宿主机打开 Browserless / 改写 liveURL 用（对应 BROWSERLESS_HOST_PORT）
GEO_WEB_CRAWL_LIVE_VIEW_BASE_URL=http://127.0.0.1:3001
# 空=不截图；调试设 /tmp/geo-crawl-live（已挂载到 ./live-shots）
# 超时/发送失败时也会往这里写 debug-*.png（需 LIVE 或仅设此目录）
GEO_WEB_CRAWL_LIVE_VIEW_SCREENSHOT_DIR=
GEO_WEB_CRAWL_LIVE_VIEW_SCREENSHOT_S=5
