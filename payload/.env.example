# PostgreSQL（与产品库 arbin_aperix_geo 同实例、独立 database：arbin_aperix_cms）
# 本地示例：postgresql://aperix:aperix@127.0.0.1:5432/arbin_aperix_cms
DATABASE_URL=postgresql://aperix:aperix@127.0.0.1:5432/arbin_aperix_cms

# 随机长字符串，生产务必更换（CMS 签名 + 官网预览校验）
PAYLOAD_SECRET=change-me-to-a-long-random-string

# 公网访问地址（生产填 https://aperix.ai）
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# 官网地址（CORS）
WEBSITE_URL=http://localhost:4321

# 邮件（与 backend SMTP_* 一致；留空则本地使用 Ethereal 测试账号）
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=cms@example.com
# SMTP_FROM_NAME=Aperix Web
# SMTP_USE_TLS=true

# 联系我们表单通知收件人（默认 SMTP_FROM / SMTP_USER）
# CONTACT_EMAIL_TO=hello@example.com
# CONTACT_SITE_NAME=Aperix AI
