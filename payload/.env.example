# PostgreSQL（与产品库 arbin_aperix_geo 同实例、独立 database：arbin_aperix_cms）
# 本地示例：postgresql://aperix:aperix@127.0.0.1:5432/arbin_aperix_cms
DATABASE_URL=postgresql://aperix:aperix@127.0.0.1:5432/arbin_aperix_cms

# 随机长字符串，生产务必更换（CMS 签名 + 官网预览校验）
PAYLOAD_SECRET=change-me-to-a-long-random-string

# Payload 服务公网地址（CORS / CSRF；生产填 CMS 对外 URL）
PAYLOAD_SERVER_URL=http://localhost:3000

# 官网地址（CORS / 预览 URL）
PUBLIC_WEBSITE_URL=http://localhost:4321

# 百度搜索资源平台 · 普通收录 API（可选；未配置则跳过推送）
# site / token 从站长平台 → 普通收录 → API 提交 的示例 curl 原样复制（site 可能带 https://）
# CMS 发布 hook 依赖进程环境（next start 会读 .env.production；改完需重启容器）
# 脚本 baidu:push-static 会自行加载 .env.production
# BAIDU_PUSH_SITE=https://www.aperix.cn
# BAIDU_PUSH_TOKEN=

# 邮件（与 backend SMTP_* 一致；留空则本地使用 Ethereal 测试账号）
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=cms@example.com
# SMTP_FROM_NAME=Aperix Web
# SMTP_USE_TLS=true
