# 复制为 settings.yml 后按需修改
# 文档: https://docs.searxng.org/admin/settings/settings
# 引擎列表: https://docs.searxng.org/admin/settings/settings_engines.html

use_default_settings: true

general:
  instance_name: "Aperix SearXNG"

server:
  secret_key: "PJDiJi8Yi1r8TPRrROr5ZE7a1bw1e9zB"
  # 仅内网后端调用时可考虑:
  # limiter: false

search:
  default_lang: "zh-CN"
  autocomplete: "baidu"
  autocomplete_min: 2
  # 允许支持翻页的引擎继续拉第 2 页（0=不限制页数，慎用）
  # max_page: 2
  formats:
    - html
    - json

ui:
  default_theme: simple

# engines：enabled 的引擎参与「默认聚合」；disabled: true 的不会被执行。
# number_of_results 与后端 COMPETITOR_SEARCH_PAGE_SIZE=50 对齐（单引擎上限，合并后仍可能 <50）。
engines:
  # ── 国内网页（按需开启；百度/搜狗易 CAPTCHA，可只留 360search）──
  - name: baidu
    disabled: false
    timeout: 10.0
    number_of_results: 50

  - name: sogou
    disabled: false
    timeout: 10.0
    number_of_results: 50

  - name: 360search
    disabled: false
    timeout: 10.0
    number_of_results: 50

  - name: quark
    disabled: true

  # 百度长期 CAPTCHA 时可改为 disabled: true，仅依赖 sogou + 360search

  # ── 常见境外 / 通用引擎（国内实例建议全部 disabled: true）──
  - name: google
    disabled: true

  - name: bing
    disabled: true

  - name: duckduckgo
    disabled: true

  - name: brave
    disabled: true

  - name: startpage
    disabled: true

  - name: wikipedia
    disabled: true

  - name: wikidata
    disabled: true

  - name: qwant
    disabled: true

  - name: mojeek
    disabled: true

  - name: yandex
    disabled: true

  - name: yahoo
    disabled: true
