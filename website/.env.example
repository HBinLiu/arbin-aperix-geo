# Payload REST API（生产同域路径；本地 dev 直连 :3000）
PAYLOAD_API_URL=/cms/api

# 与 payload/.env 中 PAYLOAD_SECRET 一致（研究报告 Admin「预览」按钮）
PAYLOAD_SECRET=change-me-to-a-long-random-string

# 产品 API（定价页等，本地直连 backend）
BACKEND_API_URL=http://127.0.0.1:8000/api/v1

# 官网 CTA：本地指向 Vite 控制台；生产写 https://app.aperix.cn/auth/login
PUBLIC_REGISTER_URL=http://127.0.0.1:5173/auth/login
PUBLIC_LOGIN_URL=http://127.0.0.1:5173/auth/login

# 国内站长验证（可选；填后台给出的 content，空则不输出 meta）
# PUBLIC_BAIDU_SITE_VERIFICATION=
# PUBLIC_SOGOU_SITE_VERIFICATION=
# PUBLIC_360_SITE_VERIFICATION=
# PUBLIC_SHENMA_SITE_VERIFICATION=
# PUBLIC_BYTEDANCE_SITE_VERIFICATION=
