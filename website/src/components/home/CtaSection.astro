---
import type { CtaContent } from "@/lib/home";
import { ArrowRight } from "@lucide/astro";

type Props = CtaContent;

const {
  badge,
  titleBefore,
  titleHighlight,
  titleAfter,
  description,
  codeLines,
  secondaryCtaLabel,
  secondaryCtaHref,
  primaryCtaLabel,
  primaryCtaHref,
} = Astro.props;
---

<section id="cta" class="cta-section scroll-mt-16 py-16 sm:py-20">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="cta-panel">
      <div class="cta-dots" aria-hidden="true"></div>
      <div class="cta-glow" aria-hidden="true"></div>
      <div class="cta-fade" aria-hidden="true"></div>

      <div class="cta-grid">
        <div class="cta-main">
          <div class="cta-badge">
            <span class="cta-badge-dot" aria-hidden="true"></span>
            <span>{badge}</span>
          </div>
          <h2 class="cta-title">
            {titleBefore}
            <span class="cta-title-highlight">{titleHighlight}</span>
            {titleAfter}
          </h2>
        </div>

        <div class="cta-side">
          <p class="cta-desc">{description}</p>

          {
            codeLines.length > 0 && (
              <div class="cta-code">
                {codeLines.map((line) => (
                  <div>{line}</div>
                ))}
              </div>
            )
          }

          <div class="cta-actions">
            <a href={secondaryCtaHref} class="cta-btn cta-btn-secondary">
              {secondaryCtaLabel}
            </a>
            <a href={primaryCtaHref} class="cta-btn cta-btn-primary group">
              <span>{primaryCtaLabel}</span>
              <ArrowRight size={18} aria-hidden="true" class="cta-btn-icon" />
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
