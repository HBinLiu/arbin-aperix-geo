---
import type { DiagnosticContent } from "@/lib/home";
import DiagnosticRotatingWord from "@/components/home/DiagnosticRotatingWord";
import StaticImage from "@/components/StaticImage.tsx";
import { DIAGNOSTIC_BACKGROUND_URL, PLATFORM_LOGO_RENDER_PX } from "@/lib/assets";
import {
  HERO_PLATFORM_IDS,
  platformLabel,
  platformLogoPublicPath,
} from "@shared/platform";

type Props = {
  diagnostic: DiagnosticContent;
};

const { diagnostic } = Astro.props;
---

<section id="diagnostic" class="diagnostic-section scroll-mt-16 py-16 sm:py-20">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="diagnostic-card">
      <div
        class="diagnostic-card-bg"
        style={`background-image: url(${DIAGNOSTIC_BACKGROUND_URL})`}
        aria-hidden="true"
      ></div>
      <div class="diagnostic-card-overlay" aria-hidden="true"></div>

      <div class="diagnostic-card-content">
        <p class="diagnostic-eyebrow">{diagnostic.eyebrow}</p>

        <h2 class="diagnostic-title">
          <span class="block">
            {diagnostic.titleLine1}
            <DiagnosticRotatingWord client:visible words={diagnostic.rotatingHighlights} />
            {diagnostic.titleLine2Suffix}
          </span>
        </h2>

        <div class="diagnostic-actions">
          <a href={diagnostic.ctaHref} class="btn btn-primary diagnostic-cta group">
            <span>{diagnostic.ctaLabel}</span>
            <svg
              class="diagnostic-cta-icon"
              xmlns="http://www.w3.org/2000/svg"
              width="21"
              height="20"
              viewBox="0 0 21 20"
              fill="currentColor"
              aria-hidden="true"
            >
              <path
                fill-rule="evenodd"
                clip-rule="evenodd"
                d="M11.5774 4.41073C11.9028 4.0853 12.4305 4.0853 12.7559 4.41073L17.7559 9.41073C18.0814 9.73617 18.0814 10.2638 17.7559 10.5892L12.7559 15.5892C12.4305 15.9147 11.9028 15.9147 11.5774 15.5892C11.252 15.2638 11.252 14.7362 11.5774 14.4107L15.1548 10.8333H3.83333C3.3731 10.8333 3 10.4602 3 9.99999C3 9.53975 3.3731 9.16666 3.83333 9.16666H15.1548L11.5774 5.58925C11.252 5.26381 11.252 4.73617 11.5774 4.41073Z"
              ></path>
            </svg>
          </a>

          <ul class="diagnostic-platforms" aria-label="支持的 AI 引擎">
            {
              HERO_PLATFORM_IDS.map((id) => (
                <li class="diagnostic-platform-item">
                  <StaticImage
                    src={platformLogoPublicPath(id)}
                    alt={platformLabel(id)}
                    width={PLATFORM_LOGO_RENDER_PX}
                    height={PLATFORM_LOGO_RENDER_PX}
                    className="size-7 object-contain"
                    loading="lazy"
                  />
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>
