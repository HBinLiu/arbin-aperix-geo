---
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import StaticImage from "@/components/StaticImage.tsx";
import FindTopicsFeatureCard from "@/components/platform/FindTopicsFeatureCard.astro";
import CtaSection from "@/components/home/CtaSection.astro";
import { ArrowRight, Minus, Plus } from "@lucide/astro";
import { HERO_GRID } from "@/lib/assets";
import {
  FIND_TOPICS_VIDEO_URL,
  findTopicsIdeasCta,
  findTopicsIdeasFaqs,
  findTopicsIdeasFeatures,
  findTopicsIdeasFeaturesHeader,
  findTopicsIdeasHero,
} from "@/lib/platform/find-topics";
import type { SiteSettings } from "@/lib/payload";

type Props = {
  settings: SiteSettings;
};

const { settings } = Astro.props;

const featureLayout = [
  { items: findTopicsIdeasFeatures.slice(0, 2), columns: 2 as const },
  { items: findTopicsIdeasFeatures.slice(2, 4), columns: 2 as const },
];
---

<SiteHeader settings={settings} />

<main class="flex flex-1 flex-col">
  <section class="aei-hero">
    <div class="aei-hero-bg" aria-hidden="true">
      <div class="aei-hero-perspective">
        <div class="aei-hero-perspective-top">
          <StaticImage
            image={HERO_GRID}
            alt=""
            className="aei-hero-grid-img"
            loading="eager"
          />
        </div>
        <div class="aei-hero-perspective-bottom">
          <StaticImage
            image={HERO_GRID}
            alt=""
            className="aei-hero-grid-img"
            loading="eager"
          />
        </div>
      </div>
      <div class="aei-hero-overlay"></div>
    </div>

    <div class="aei-hero-inner mx-auto w-full max-w-6xl px-4 sm:px-6">
      <div class="aei-hero-copy">
        <h1 class="aei-hero-title">
          {findTopicsIdeasHero.titleBefore}
          <span class="aei-hero-highlight">{findTopicsIdeasHero.titleHighlight}</span>
          {findTopicsIdeasHero.titleAfter}
        </h1>
        <p class="aei-hero-tagline">{findTopicsIdeasHero.tagline}</p>
        <p class="aei-hero-desc">{findTopicsIdeasHero.description}</p>
        <div class="aei-hero-actions">
          <a href={findTopicsIdeasHero.primaryCtaHref} class="aei-cta aei-cta--primary group">
            <span>{findTopicsIdeasHero.primaryCtaLabel}</span>
            <ArrowRight size={16} aria-hidden="true" />
          </a>
          <a href={findTopicsIdeasHero.secondaryCtaHref} class="aei-cta aei-cta--secondary">
            {findTopicsIdeasHero.secondaryCtaLabel}
          </a>
        </div>
      </div>

      <div class="aei-hero-video-frame">
        <div class="aei-hero-video-inner" data-aei-hero-video>
          <div class="aei-hero-video-loading" aria-hidden="true">
            <span class="aei-hero-video-spinner"></span>
          </div>
          <video class="aei-hero-video" autoplay loop muted playsinline preload="metadata">
            <source src={FIND_TOPICS_VIDEO_URL} type="video/webm" />
          </video>
        </div>
      </div>
    </div>
  </section>

  <section class="aei-features">
    <div class="aei-features-inner mx-auto w-full max-w-6xl px-4 sm:px-6">
      <header class="aei-features-header">
        <h2 class="aei-features-title">
          {findTopicsIdeasFeaturesHeader.titleBefore}
          <span class="aei-features-title-highlight">
            {findTopicsIdeasFeaturesHeader.titleHighlight}
          </span>
        </h2>
        <p class="aei-features-desc">{findTopicsIdeasFeaturesHeader.description}</p>
      </header>

      <div class="fti-feature-list">
        {
          featureLayout.map(({ items, columns }) => {
            if (items.length === 0) return null;
            return (
              <div class:list={["fti-feature-row", columns === 3 && "fti-feature-row--3"]}>
                {items.map((feature) => (
                  <FindTopicsFeatureCard feature={feature} />
                ))}
              </div>
            );
          })
        }
      </div>
    </div>
  </section>

  <section id="faq" class="aei-faq scroll-mt-16">
    <div class="aei-faq-inner mx-auto w-full max-w-6xl px-4 sm:px-6">
      <header class="aei-faq-header">
        <h2 class="aei-faq-title">常见问题</h2>
        <p class="aei-faq-subtitle">我们已整理了最关键的信息，以助您最大化您的体验价值。</p>
      </header>

      <div class="aei-faq-list" data-aei-faq-list>
        {
          findTopicsIdeasFaqs.map((item, index) => (
            <div class:list={["aei-faq-item", index === 0 && "is-open"]} data-aei-faq-item>
              <button
                type="button"
                id={`fti-faq-trigger-${index}`}
                class="aei-faq-trigger"
                aria-expanded={index === 0 ? "true" : "false"}
                aria-controls={`fti-faq-answer-${index}`}
              >
                <div class="aei-faq-meta-row">
                  <span class="aei-faq-number">{item.number}</span>
                  <span class="aei-faq-label">/// {item.label}</span>
                </div>
                <h3 class="aei-faq-question">{item.question}</h3>
                <span class="aei-faq-icon" aria-hidden="true">
                  <Plus size={16} class="aei-faq-icon-plus" />
                  <Minus size={16} class="aei-faq-icon-minus" />
                </span>
              </button>
              <div
                id={`fti-faq-answer-${index}`}
                class="aei-faq-body"
                role="region"
                aria-labelledby={`fti-faq-trigger-${index}`}
              >
                <div class="aei-faq-body-inner">
                  {item.paragraphs.map((paragraph) => (
                    <p>{paragraph}</p>
                  ))}
                  {item.bullets && item.bullets.length > 0 && (
                    <ul class="aei-faq-bullets">
                      {item.bullets.map((bullet) => (
                        <li>{bullet}</li>
                      ))}
                    </ul>
                  )}
                  {item.closingParagraphs?.map((paragraph) => (
                    <p>{paragraph}</p>
                  ))}
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <CtaSection {...findTopicsIdeasCta} />
</main>

<SiteFooter settings={settings} />

<script>
  function initInsightsFaq(list: HTMLElement) {
    const items = Array.from(list.querySelectorAll<HTMLElement>("[data-aei-faq-item]"));

    items.forEach((item) => {
      const trigger = item.querySelector<HTMLButtonElement>(".aei-faq-trigger");
      if (!trigger) return;

      trigger.addEventListener("click", () => {
        const isOpen = item.classList.contains("is-open");

        items.forEach((other) => {
          other.classList.remove("is-open");
          other.querySelector<HTMLButtonElement>(".aei-faq-trigger")?.setAttribute(
            "aria-expanded",
            "false",
          );
        });

        if (!isOpen) {
          item.classList.add("is-open");
          trigger.setAttribute("aria-expanded", "true");
        }
      });
    });
  }

  function setupInsightsFaq() {
    document.querySelectorAll<HTMLElement>("[data-aei-faq-list]").forEach((list) => {
      if (list.dataset.aeiFaqBound === "true") return;
      list.dataset.aeiFaqBound = "true";
      initInsightsFaq(list);
    });
  }

  function initHeroVideo(root: HTMLElement) {
    if (root.dataset.aeiVideoBound === "true") return;

    const video = root.querySelector<HTMLVideoElement>(".aei-hero-video");
    if (!video) return;

    root.dataset.aeiVideoBound = "true";

    const markReady = () => {
      root.classList.add("is-ready");
      root.removeAttribute("aria-busy");
    };

    root.setAttribute("aria-busy", "true");

    if (video.readyState >= HTMLMediaElement.HAVE_FUTURE_DATA) {
      markReady();
      return;
    }

    video.addEventListener("canplay", markReady, { once: true });
    video.addEventListener("error", markReady, { once: true });
  }

  function setupHeroVideos() {
    document.querySelectorAll<HTMLElement>("[data-aei-hero-video]").forEach(initHeroVideo);
  }

  setupInsightsFaq();
  setupHeroVideos();
  document.addEventListener("astro:page-load", () => {
    setupInsightsFaq();
    setupHeroVideos();
  });
</script>
