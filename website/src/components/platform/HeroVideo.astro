---
import type { HeroVideoSources } from "@/lib/platform/hero-video";

type Props = {
  sources: HeroVideoSources;
  /** 无障碍：简短描述画面内容 */
  label?: string;
};

const { sources, label = "产品演示视频" } = Astro.props;
---

<div class="aei-hero-video-frame">
  <div class="aei-hero-video-inner" data-aei-hero-video>
    <div class="aei-hero-video-loading" aria-hidden="true">
      <span class="aei-hero-video-spinner"></span>
    </div>
    <button type="button" class="aei-hero-video-play" data-aei-hero-play hidden aria-label="播放视频">
      <span class="aei-hero-video-play-icon" aria-hidden="true"></span>
    </button>
    {/* 初始不放 source：由客户端按环境写入，避免微信先试 WebM 失败 */}
    <video
      class="aei-hero-video"
      data-src-webm={sources.webm}
      data-src-mp4={sources.mp4}
      muted
      loop
      playsinline
      preload="auto"
      aria-label={label}
      {...{
        "webkit-playsinline": true,
        "x5-playsinline": "true",
        "x5-video-player-type": "h5",
        "x5-video-player-fullscreen": "true",
      }}
    >
    </video>
  </div>
</div>

<script>
  import { initPlatformHeroVideos } from "@/lib/platform/hero-video-client";

  initPlatformHeroVideos();
  document.addEventListener("astro:page-load", initPlatformHeroVideos);
</script>
