---
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import StaticImage from "@/components/StaticImage.tsx";
import PromptFeatureCard from "@/components/platform/PromptFeatureCard.astro";
import HeroVideo from "@/components/platform/HeroVideo.astro";
import PlatformFaqSection from "@/components/platform/PlatformFaqSection.astro";
import CtaSection from "@/components/home/CtaSection.astro";
import { ArrowRight } from "@lucide/astro";
import { HERO_GRID } from "@/lib/assets";
import {
  PROMPT_VIDEO,
  promptExplorerCta,
  promptExplorerFeatures,
  promptExplorerFeaturesHeader,
  promptExplorerHero,
} from "@/lib/platform/prompt";
import type { Faq } from "@/lib/platform/faq";

type Props = {
  faqs: Faq[];
};

const { faqs } = Astro.props;
const featureLayout = [
  { items: promptExplorerFeatures.slice(0, 2), columns: 2 as const },
  { items: promptExplorerFeatures.slice(2, 5), columns: 3 as const },
];
---

<SiteHeader />

<main class="flex flex-1 flex-col">
  <section class="aei-hero">
    <div class="aei-hero-bg" aria-hidden="true">
      <div class="aei-hero-perspective">
        <div class="aei-hero-perspective-top">
          <StaticImage
            image={HERO_GRID}
            alt=""
            className="aei-hero-grid-img"
            loading="eager"
          />
        </div>
        <div class="aei-hero-perspective-bottom">
          <StaticImage
            image={HERO_GRID}
            alt=""
            className="aei-hero-grid-img"
            loading="eager"
          />
        </div>
      </div>
      <div class="aei-hero-overlay"></div>
    </div>

    <div class="aei-hero-inner mx-auto w-full max-w-6xl px-4 sm:px-6">
      <div class="aei-hero-copy">
        <h1 class="aei-hero-title">
          {promptExplorerHero.titleBefore}
          <span class="aei-hero-highlight">{promptExplorerHero.titleHighlight}</span>
          {promptExplorerHero.titleAfter}
        </h1>
        <p class="aei-hero-tagline">{promptExplorerHero.tagline}</p>
        <p class="aei-hero-desc">{promptExplorerHero.description}</p>
        <div class="aei-hero-actions">
          <a href={promptExplorerHero.primaryCtaHref} class="aei-cta aei-cta--primary group">
            <span>{promptExplorerHero.primaryCtaLabel}</span>
            <ArrowRight size={16} aria-hidden="true" />
          </a>
          <a href={promptExplorerHero.secondaryCtaHref} class="aei-cta aei-cta--secondary">
            {promptExplorerHero.secondaryCtaLabel}
          </a>
        </div>
      </div>

      <HeroVideo sources={PROMPT_VIDEO} label="Prompt 探索演示" />
    </div>
  </section>

  <section class="aei-features">
    <div class="aei-features-inner mx-auto w-full max-w-6xl px-4 sm:px-6">
      <header class="aei-features-header">
        <h2 class="aei-features-title">
          {promptExplorerFeaturesHeader.titleBefore}
          <span class="aei-features-title-highlight">
            {promptExplorerFeaturesHeader.titleHighlight}
          </span>
        </h2>
        <p class="aei-features-desc">{promptExplorerFeaturesHeader.description}</p>
      </header>

      <div class="pve-feature-list">
        {
          featureLayout.map(({ items, columns }) => {
            if (items.length === 0) return null;
            return (
              <div class:list={["pve-feature-row", columns === 3 && "pve-feature-row--3"]}>
                {items.map((feature) => (
                  <PromptFeatureCard feature={feature} />
                ))}
              </div>
            );
          })
        }
      </div>
    </div>
  </section>

  <PlatformFaqSection items={faqs} idPrefix="pve-faq" />

  <CtaSection {...promptExplorerCta} />
</main>

<SiteFooter />
