---
import { appLinks } from "@/lib/app-links";
import SiteHeaderNav from "@/components/menu/SiteHeaderNav";
import SiteMobileNav from "@/components/menu/SiteMobileNav";
import StaticImage from "@/components/StaticImage.tsx";
import { LOGO_RENDER_PX } from "@/lib/assets";
import { siteConfig } from "@site";

const { name, description, logo } = siteConfig;
---

<header class="site-header border-border/40 bg-background/80 sticky top-0 z-50 overflow-visible border-b backdrop-blur-md">
  <div class="mx-auto grid h-14 max-w-6xl grid-cols-[1fr_auto] items-center gap-3 px-4 md:grid-cols-[auto_1fr_auto] md:gap-4 md:px-6 sm:h-16">
    <a href="/" class="flex shrink-0 items-center gap-2.5" title={description}>
      <StaticImage
        src={logo}
        alt={name}
        width={LOGO_RENDER_PX}
        height={LOGO_RENDER_PX}
        className="size-9 shrink-0 object-contain sm:size-10"
        loading="eager"
      />
      <div class="flex min-w-0 flex-col leading-tight">
        <span class="truncate text-sm font-semibold tracking-tight sm:text-base">{name}</span>
        <span class="text-foreground truncate text-xs">{description}</span>
      </div>
    </a>

    <div class="hidden justify-center md:flex">
      <SiteHeaderNav client:load />
    </div>

    <div class="hidden shrink-0 items-center justify-end gap-2 sm:gap-3 md:flex">
      <a href={appLinks.login} class="btn btn-ghost hidden sm:inline-flex">登录</a>
      <a href={appLinks.register} class="btn btn-primary text-xs sm:text-sm">开始试用</a>
    </div>

    <SiteMobileNav client:load />
  </div>
</header>
