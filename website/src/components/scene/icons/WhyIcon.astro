---
import type { SceneWhyIcon } from "@/lib/scene/types";
import {
  Activity,
  Brain,
  ChartNoAxesColumn,
  CircleQuestionMark,
  Clock,
  Layers,
  Lightbulb,
  MessageSquareQuote,
  Search,
  Shield,
  Target,
  Timeline,
  Zap,
} from "@lucide/astro";

type Props = {
  icon: SceneWhyIcon;
};

const { icon } = Astro.props;

const lucideIcons = {
  activity: Activity,
  "bar-chart": ChartNoAxesColumn,
  brain: Brain,
  clock: Clock,
  "help-circle": CircleQuestionMark,
  layers: Layers,
  quote: MessageSquareQuote,
  search: Search,
  shield: Shield,
  target: Target,
  timeline: Timeline,
  zap: Zap,
  lightbulb: Lightbulb,
} as const;
---

