---
import type { SceneWorkflowIcon } from "@/lib/scene/types";
import { Briefcase, MessageSquareQuote, Shield, Target } from "@lucide/astro";

type Props = {
  icon: SceneWorkflowIcon;
};

const { icon } = Astro.props;

const lucideIcons = {
  briefcase: Briefcase,
  quote: MessageSquareQuote,
  shield: Shield,
  target: Target,
