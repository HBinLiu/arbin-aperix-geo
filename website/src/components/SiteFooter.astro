---
import StaticImage from "@/components/StaticImage.tsx";
import { LOGO_RENDER_PX } from "@/lib/assets";
import {
  footerBeian,
  footerColumnRows,
  footerLegalLinks,
  footerSocialLinks,
  footerSocialSvg,
  footerTagline,
  isNavigableFooterHref,
  socialButtonClass,
} from "@/lib/footer";
import { siteConfig } from "@site";

const year = new Date().getFullYear();
const { name, description, logo } = siteConfig;
---

<footer class="border-border bg-background border-t">
  <div class="mx-auto max-w-6xl px-4 py-12 md:px-6">
    <div class="flex flex-col gap-12">
      <div class="flex flex-col gap-3">
        <a href="/" class="flex items-center gap-2" aria-label={`返回${name}首页`} title={description}>
          <StaticImage
            src={logo}
            alt={name}
            width={LOGO_RENDER_PX}
            height={LOGO_RENDER_PX}
            className="h-7 w-auto shrink-0 object-contain"
            loading="eager"
          />
        </a>
        <p class="text-muted-foreground max-w-[48ch] text-sm leading-snug">{footerTagline}</p>
        <div class="flex items-center gap-3">
          {
            footerSocialLinks.map((link) =>
              isNavigableFooterHref(link.href) ? (
                <a
                  href={link.href}
                  aria-label={link.label}
                  target={link.external ? "_blank" : undefined}
                  rel={link.external ? "noreferrer noopener" : undefined}
                >
                  <span class={socialButtonClass}>
                    <Fragment set:html={footerSocialSvg(link)} />
                  </span>
                </a>
              ) : (
                <span class={socialButtonClass} aria-label={link.label} title="即将上线">
                  <Fragment set:html={footerSocialSvg(link)} />
                </span>
              ),
            )
          }
        </div>
      </div>

      <div class="border-border border-t" aria-hidden="true"></div>

      <div class="flex flex-col gap-12">
        {
          footerColumnRows.map((row) => (
            <div class="grid grid-cols-2 gap-x-10 gap-y-10 lg:grid-cols-4 lg:gap-6">
              {row.map((column) => (
                <div class="flex min-w-0 flex-col gap-4">
                  <p class="text-foreground text-sm leading-snug font-medium">{column.title}</p>
                  <ul class="flex flex-col gap-2">
                    {column.links.map((link) => (
                      <li>
                        <a
                          href={link.href}
                          class="text-muted-foreground hover:text-foreground block py-1 text-sm leading-snug transition-colors"
                          target={link.external ? "_blank" : undefined}
                          rel={link.external ? "noreferrer noopener" : undefined}
                        >
                          {link.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          ))
        }
      </div>

      <div class="border-border border-t" aria-hidden="true"></div>

      <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div class="text-muted-foreground flex flex-col gap-2 text-sm leading-5 sm:flex-row sm:flex-wrap sm:items-center sm:gap-x-3 sm:gap-y-1">
          <p>© {year} {name}. All rights reserved.</p>
          <a
            href={footerBeian.href}
            class="hover:text-foreground transition-colors"
            target="_blank"
            rel="noreferrer noopener"
          >
            {footerBeian.label}
          </a>
        </div>
        <div class="flex flex-wrap items-center gap-3">
          {
            footerLegalLinks.map((link) =>
              isNavigableFooterHref(link.href) ? (
                <a
                  href={link.href}
                  class="text-muted-foreground hover:text-foreground text-sm leading-none transition-colors"
                >
                  {link.label}
                </a>
              ) : (
                <span class="text-muted-foreground text-sm leading-none">{link.label}</span>
              ),
            )
          }
        </div>
      </div>
    </div>
  </div>
</footer>
