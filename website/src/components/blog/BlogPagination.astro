---
type Props = {
  variant?: "blog" | "author";
  authorSlug?: string;
};

const { variant = "blog", authorSlug = "" } = Astro.props;
---

<nav
  class="blog-pagination"
  id="blog-pagination"
  aria-label="博客分页"
  hidden
  data-blog-pagination-variant={variant}
  data-blog-pagination-author={authorSlug}
></nav>

<script>
  import {
    BLOG_LIST_PAGE_SIZE,
    buildAuthorListUrl,
    buildBlogListUrl,
    getBlogPageItems,
    parseBlogListCategory,
    parseBlogListPage,
    parseBlogListSearch,
  } from "@/lib/blog/pagination";

  const paginationEl = document.getElementById("blog-pagination");
  if (!paginationEl) {
    // no-op
  } else {
    const paginationRoot = paginationEl;
    const variant = paginationRoot.dataset.blogPaginationVariant ?? "blog";
    const authorSlug = paginationRoot.dataset.blogPaginationAuthor ?? "";
    const isAuthor = variant === "author" && authorSlug.length > 0;

    const categoryPills = document.querySelectorAll<HTMLAnchorElement>("[data-blog-category-filter]");
    const cards = [...document.querySelectorAll<HTMLElement>("[data-blog-card]")];
    const searchForm = document.querySelector<HTMLFormElement>("[data-blog-search-form]");
    const searchInput = document.querySelector<HTMLInputElement>("[data-blog-search-input]");

    const initialParams = new URLSearchParams(window.location.search);
    let activeCategory = isAuthor ? "all" : parseBlogListCategory(initialParams);
    let activePage = parseBlogListPage(initialParams.get("page"));
    let activeSearch = isAuthor ? "" : parseBlogListSearch(initialParams);

    if (searchInput && !isAuthor) {
      searchInput.value = activeSearch;
    }

    function buildUrl(page: number, category: string, search: string): string {
      if (isAuthor) {
        return buildAuthorListUrl(authorSlug, page);
      }
      return buildBlogListUrl(page, category, search);
    }

    function setActiveCategoryPill(category: string) {
      categoryPills.forEach((pill) => {
        const isActive = (pill.dataset.blogCategoryFilter ?? "all") === category;
        pill.classList.toggle("is-active", isActive);
        if (isActive) pill.setAttribute("aria-current", "page");
        else pill.removeAttribute("aria-current");
      });
    }

    function renderPagination(page: number, totalPages: number, category: string, search: string) {
      if (totalPages <= 1) {
        paginationRoot.hidden = true;
        paginationRoot.replaceChildren();
        return;
      }

      paginationRoot.hidden = false;

      const list = document.createElement("ul");
      list.className = "blog-pagination-list";

      const prevItem = document.createElement("li");
      if (page <= 1) {
        prevItem.innerHTML =
          '<span class="blog-pagination-control is-disabled" aria-disabled="true" aria-label="上一页"><span>上一页</span></span>';
      } else {
        const href = buildUrl(page - 1, category, search);
        prevItem.innerHTML = `<a class="blog-pagination-control" href="${href}" data-blog-page="${page - 1}" aria-label="上一页"><span>上一页</span></a>`;
      }
      list.appendChild(prevItem);

      for (const item of getBlogPageItems(page, totalPages)) {
        const li = document.createElement("li");
        if (item === "ellipsis") {
          li.innerHTML = '<span class="blog-pagination-ellipsis" aria-hidden="true">…</span>';
        } else if (item === page) {
          li.innerHTML = `<span class="blog-pagination-page is-active" aria-current="page">${item}</span>`;
        } else {
          const href = buildUrl(item, category, search);
          li.innerHTML = `<a class="blog-pagination-page" href="${href}" data-blog-page="${item}">${item}</a>`;
        }
        list.appendChild(li);
      }

      const nextItem = document.createElement("li");
      if (page >= totalPages) {
        nextItem.innerHTML =
          '<span class="blog-pagination-control is-disabled" aria-disabled="true" aria-label="下一页"><span>下一页</span></span>';
      } else {
        const href = buildUrl(page + 1, category, search);
        nextItem.innerHTML = `<a class="blog-pagination-control" href="${href}" data-blog-page="${page + 1}" aria-label="下一页"><span>下一页</span></a>`;
      }
      list.appendChild(nextItem);

      paginationRoot.replaceChildren(list);
    }

    function syncUrl(page: number, category: string, search: string) {
      const nextUrl = buildUrl(page, category, search);
      if (`${window.location.pathname}${window.location.search}` !== nextUrl) {
        history.replaceState(null, "", nextUrl);
      }
    }

    function normalizeSearch(value: string): string {
      return value.trim().toLowerCase();
    }

    function cardMatchesSearch(card: HTMLElement, search: string): boolean {
      if (!search) return true;
      const haystack = [
        card.dataset.blogCardTitle ?? "",
        card.dataset.blogCardDescription ?? "",
      ]
        .join(" ")
        .toLowerCase();
      return haystack.includes(search);
    }

    function applyListState(page: number, category: string, search: string) {
      const normalizedSearch = normalizeSearch(search);

      const matchedCards = cards.filter((card) => {
        const cardCategory = card.dataset.blogCardCategory ?? "";
        const categoryMatch = isAuthor || category === "all" || cardCategory === category;
        return categoryMatch && cardMatchesSearch(card, normalizedSearch);
      });

      const totalPages = Math.max(1, Math.ceil(matchedCards.length / BLOG_LIST_PAGE_SIZE));
      const safePage = Math.min(Math.max(1, page), totalPages);
      const start = (safePage - 1) * BLOG_LIST_PAGE_SIZE;

      cards.forEach((card) => card.classList.add("is-hidden"));
      matchedCards.slice(start, start + BLOG_LIST_PAGE_SIZE).forEach((card) => {
        card.classList.remove("is-hidden");
      });

      const emptyEl = document.querySelector<HTMLElement>("[data-blog-grid-empty]");
      if (emptyEl) {
        emptyEl.hidden = matchedCards.length > 0;
      }

      activeCategory = category;
      activePage = safePage;
      activeSearch = search;
      if (!isAuthor) {
        setActiveCategoryPill(category);
      }
      renderPagination(safePage, totalPages, category, search);
      syncUrl(safePage, category, search);
    }

    categoryPills.forEach((pill) => {
      pill.addEventListener("click", (event) => {
        event.preventDefault();
        applyListState(1, pill.dataset.blogCategoryFilter ?? "all", activeSearch);
      });
    });

    if (searchForm && !isAuthor) {
      searchForm.addEventListener("submit", (event) => {
        event.preventDefault();
        const nextSearch = searchInput?.value ?? "";
        applyListState(1, activeCategory, nextSearch);
      });
    }

    paginationRoot.addEventListener("click", (event) => {
      const target = (event.target as HTMLElement | null)?.closest<HTMLAnchorElement>("[data-blog-page]");
      if (!target) return;
      event.preventDefault();
      applyListState(parseBlogListPage(target.dataset.blogPage), activeCategory, activeSearch);
    });

    window.addEventListener("popstate", () => {
      const params = new URLSearchParams(window.location.search);
      const nextSearch = isAuthor ? "" : parseBlogListSearch(params);
      if (searchInput && !isAuthor) {
        searchInput.value = nextSearch;
      }
      applyListState(
        parseBlogListPage(params.get("page")),
        isAuthor ? "all" : parseBlogListCategory(params),
        nextSearch,
      );
    });

    applyListState(activePage, activeCategory, activeSearch);
  }
</script>
