<nav class="research-pagination" id="research-pagination" aria-label="报告分页" hidden></nav>

<script>
  import {
    RESEARCH_LIST_PAGE_SIZE,
    buildResearchListUrl,
    getResearchPageItems,
    parseResearchListPage,
    readResearchListCategory,
  } from "@/lib/research/pagination";

  const categoryButtons = document.querySelectorAll<HTMLButtonElement>(
    "[data-research-category-filter]",
  );
  const cards = [...document.querySelectorAll<HTMLElement>("[data-research-card]")];
  const paginationEl = document.getElementById("research-pagination");

  if (categoryButtons.length > 0 && paginationEl) {
    const paginationRoot = paginationEl;
    const initialParams = new URLSearchParams(window.location.search);
    let activeCategory = readResearchListCategory(initialParams);
    let activePage = parseResearchListPage(initialParams.get("page"));

    function setActiveCategoryButton(category: string) {
      categoryButtons.forEach((button) => {
        const isActive = (button.dataset.researchCategoryFilter ?? "all") === category;
        button.classList.toggle("is-active", isActive);
        button.setAttribute("aria-selected", isActive ? "true" : "false");
      });
    }

    function renderPagination(page: number, totalPages: number, category: string) {
      if (totalPages <= 1) {
        paginationRoot.hidden = true;
        paginationRoot.replaceChildren();
        return;
      }

      paginationRoot.hidden = false;

      const list = document.createElement("ul");
      list.className = "research-pagination-list";

      const prevItem = document.createElement("li");
      if (page <= 1) {
        prevItem.innerHTML =
          '<span class="research-pagination-control is-disabled" aria-disabled="true" aria-label="上一页"><span>上一页</span></span>';
      } else {
        const href = buildResearchListUrl(page - 1, category);
        prevItem.innerHTML = `<a class="research-pagination-control" href="${href}" data-research-page="${page - 1}" aria-label="上一页"><span>上一页</span></a>`;
      }
      list.appendChild(prevItem);

      for (const item of getResearchPageItems(page, totalPages)) {
        const li = document.createElement("li");
        if (item === "ellipsis") {
          li.innerHTML = '<span class="research-pagination-ellipsis" aria-hidden="true">…</span>';
        } else if (item === page) {
          li.innerHTML = `<span class="research-pagination-page is-active" aria-current="page">${item}</span>`;
        } else {
          const href = buildResearchListUrl(item, category);
          li.innerHTML = `<a class="research-pagination-page" href="${href}" data-research-page="${item}">${item}</a>`;
        }
        list.appendChild(li);
      }

      const nextItem = document.createElement("li");
      if (page >= totalPages) {
        nextItem.innerHTML =
          '<span class="research-pagination-control is-disabled" aria-disabled="true" aria-label="下一页"><span>下一页</span></span>';
      } else {
        const href = buildResearchListUrl(page + 1, category);
        nextItem.innerHTML = `<a class="research-pagination-control" href="${href}" data-research-page="${page + 1}" aria-label="下一页"><span>下一页</span></a>`;
      }
      list.appendChild(nextItem);

      paginationRoot.replaceChildren(list);
    }

    function syncUrl(page: number, category: string) {
      const nextUrl = buildResearchListUrl(page, category);
      if (`${window.location.pathname}${window.location.search}` !== nextUrl) {
        history.replaceState(null, "", nextUrl);
      }
    }

    function applyListState(page: number, category: string) {
      const matchedCards = cards.filter((card) => {
        const cardCategory = card.dataset.researchCardCategory ?? "";
        return category === "all" || cardCategory === category;
      });

      const totalPages = Math.max(1, Math.ceil(matchedCards.length / RESEARCH_LIST_PAGE_SIZE));
      const safePage = Math.min(Math.max(1, page), totalPages);
      const start = (safePage - 1) * RESEARCH_LIST_PAGE_SIZE;

      cards.forEach((card) => card.classList.add("is-hidden"));
      matchedCards.slice(start, start + RESEARCH_LIST_PAGE_SIZE).forEach((card) => {
        card.classList.remove("is-hidden");
      });

      activeCategory = category;
      activePage = safePage;
      setActiveCategoryButton(category);
      renderPagination(safePage, totalPages, category);
      syncUrl(safePage, category);
    }

    categoryButtons.forEach((button) => {
      button.addEventListener("click", () => {
        applyListState(1, button.dataset.researchCategoryFilter ?? "all");
      });
    });

    paginationRoot.addEventListener("click", (event) => {
      const target = (event.target as HTMLElement | null)?.closest<HTMLAnchorElement>(
        "[data-research-page]",
      );
      if (!target) return;
      event.preventDefault();
      applyListState(
        parseResearchListPage(target.dataset.researchPage),
        activeCategory,
      );
    });

    window.addEventListener("popstate", () => {
      const params = new URLSearchParams(window.location.search);
      applyListState(
        parseResearchListPage(params.get("page")),
        readResearchListCategory(params),
      );
    });

    applyListState(activePage, activeCategory);
  }
</script>
