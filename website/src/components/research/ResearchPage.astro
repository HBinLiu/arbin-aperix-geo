---
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import StaticImage from "@/components/StaticImage.tsx";
import { RESEARCH_CARD_ICON, RESEARCH_CARD_ICON_DISPLAY_PX } from "@/lib/assets";
import {
  researchHero,
  researchHref,
  researchReportsSection,
  type ResearchListItem,
} from "@/lib/research";
import ResearchPagination from "@/components/research/ResearchPagination.astro";
import { ArrowRight } from "@lucide/astro";

type ResearchCategoryOption = {
  id: string;
  label: string;
};

type Props = {
  reports: ResearchListItem[];
  categories: ResearchCategoryOption[];
};

const { reports, categories } = Astro.props;
---

<SiteHeader />

<main class="flex flex-1 flex-col">
  <section class="research-hero py-24" aria-labelledby="research-hero-title">
    <div class="research-bg-grid" aria-hidden="true"></div>
    <div class="research-hero-glow" aria-hidden="true"></div>

    <div class="mx-auto w-full max-w-6xl px-4 sm:px-6">
      <div class="research-hero-copy">
        <h1 id="research-hero-title" class="research-title">{researchHero.title}</h1>
        <p class="research-subtitle">{researchHero.description}</p>
        <a class="research-hero-cta group" href={researchHero.ctaHref}>
          <span>{researchHero.ctaLabel}</span>
          <ArrowRight size={16} aria-hidden="true" class="research-hero-cta-icon" />
        </a>
      </div>
    </div>
  </section>

  <section class="research-list pt-12 pb-24" aria-labelledby="research-reports-title">
    <div class="mx-auto w-full max-w-6xl px-4 sm:px-6">
      <header class="research-reports-head">
        <h2 id="research-reports-title" class="research-reports-title">
          {researchReportsSection.title}
        </h2>
        <p class="research-reports-subtitle">{researchReportsSection.subtitle}</p>
      </header>

      <div class="research-categories" role="tablist" aria-label="报告分类">
        {
          categories.map((category, index) => (
            <button
              type="button"
              class:list={["research-category", index === 0 && "is-active"]}
              role="tab"
              aria-selected={index === 0 ? "true" : "false"}
              data-research-category-filter={category.id}
            >
              {category.label}
            </button>
          ))
        }
      </div>

      <div class="research-grid">
        {
          reports.map((report) => (
            <a
              href={researchHref(report.slug)}
              class="research-card"
              data-research-card
              data-research-card-category={report.categorySlug}
            >
              <div class="research-card-icon" aria-hidden="true">
                <StaticImage
                  image={RESEARCH_CARD_ICON}
                  alt=""
                  width={RESEARCH_CARD_ICON_DISPLAY_PX}
                  height={RESEARCH_CARD_ICON_DISPLAY_PX}
                  loading="lazy"
                />
              </div>
              <h3 class="research-card-title">{report.cardTitle}</h3>
              <p class="research-card-desc">{report.cardDescription}</p>
              <div class="research-card-cover">
                <StaticImage
                  src={report.coverSrc}
                  alt={report.cardTitle}
                  width={341}
                  height={192}
                  loading="lazy"
                />
              </div>
            </a>
          ))
        }
      </div>

      <ResearchPagination />
    </div>
  </section>
</main>

<SiteFooter />
