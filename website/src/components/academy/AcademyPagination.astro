---
---

<nav
  class="academy-pagination"
  id="academy-pagination"
  aria-label="学院分页"
  hidden
></nav>

<script>
  import {
    ACADEMY_LIST_PAGE_SIZE,
    buildAcademyListUrl,
    getAcademyPageItems,
    parseAcademyListCategory,
    parseAcademyListPage,
    parseAcademyListSearch,
  } from "@/lib/academy/pagination";

  const paginationEl = document.getElementById("academy-pagination");
  if (!paginationEl) {
    // no-op
  } else {
    const paginationRoot = paginationEl;

    const categoryPills = document.querySelectorAll<HTMLAnchorElement>("[data-academy-category-filter]");
    const cards = [...document.querySelectorAll<HTMLElement>("[data-academy-card]")];
    const searchForm = document.querySelector<HTMLFormElement>("[data-academy-search-form]");
    const searchInput = document.querySelector<HTMLInputElement>("[data-academy-search-input]");

    const initialParams = new URLSearchParams(window.location.search);
    let activeCategory = parseAcademyListCategory(initialParams);
    let activePage = parseAcademyListPage(initialParams.get("page"));
    let activeSearch = parseAcademyListSearch(initialParams);

    if (searchInput) {
      searchInput.value = activeSearch;
    }

    function buildUrl(page: number, category: string, search: string): string {
      return buildAcademyListUrl(page, category, search);
    }

    function setActiveCategoryPill(category: string) {
      categoryPills.forEach((pill) => {
        const isActive = (pill.dataset.academyCategoryFilter ?? "all") === category;
        pill.classList.toggle("is-active", isActive);
        if (isActive) pill.setAttribute("aria-current", "page");
        else pill.removeAttribute("aria-current");
      });
    }

    function renderPagination(page: number, totalPages: number, category: string, search: string) {
      if (totalPages <= 1) {
        paginationRoot.hidden = true;
        paginationRoot.replaceChildren();
        return;
      }

      paginationRoot.hidden = false;

      const list = document.createElement("ul");
      list.className = "academy-pagination-list";

      const prevItem = document.createElement("li");
      if (page <= 1) {
        prevItem.innerHTML =
          '<span class="academy-pagination-control is-disabled" aria-disabled="true" aria-label="上一页"><span>上一页</span></span>';
      } else {
        const href = buildUrl(page - 1, category, search);
        prevItem.innerHTML = `<a class="academy-pagination-control" href="${href}" data-academy-page="${page - 1}" aria-label="上一页"><span>上一页</span></a>`;
      }
      list.appendChild(prevItem);

      for (const item of getAcademyPageItems(page, totalPages)) {
        const li = document.createElement("li");
        if (item === "ellipsis") {
          li.innerHTML = '<span class="academy-pagination-ellipsis" aria-hidden="true">…</span>';
        } else if (item === page) {
          li.innerHTML = `<span class="academy-pagination-page is-active" aria-current="page">${item}</span>`;
        } else {
          const href = buildUrl(item, category, search);
          li.innerHTML = `<a class="academy-pagination-page" href="${href}" data-academy-page="${item}">${item}</a>`;
        }
        list.appendChild(li);
      }

      const nextItem = document.createElement("li");
      if (page >= totalPages) {
        nextItem.innerHTML =
          '<span class="academy-pagination-control is-disabled" aria-disabled="true" aria-label="下一页"><span>下一页</span></span>';
      } else {
        const href = buildUrl(page + 1, category, search);
        nextItem.innerHTML = `<a class="academy-pagination-control" href="${href}" data-academy-page="${page + 1}" aria-label="下一页"><span>下一页</span></a>`;
      }
      list.appendChild(nextItem);

      paginationRoot.replaceChildren(list);
    }

    function syncUrl(page: number, category: string, search: string) {
      const nextUrl = buildUrl(page, category, search);
      if (`${window.location.pathname}${window.location.search}` !== nextUrl) {
        history.replaceState(null, "", nextUrl);
      }
    }

    function normalizeSearch(value: string): string {
      return value.trim().toLowerCase();
    }

    function cardMatchesSearch(card: HTMLElement, search: string): boolean {
      if (!search) return true;
      const haystack = [
        card.dataset.academyCardTitle ?? "",
        card.dataset.academyCardDescription ?? "",
      ]
        .join(" ")
        .toLowerCase();
      return haystack.includes(search);
    }

    function applyListState(page: number, category: string, search: string) {
      const normalizedSearch = normalizeSearch(search);

      const matchedCards = cards.filter((card) => {
        const cardCategory = card.dataset.academyCardCategory ?? "";
        const categoryMatch = category === "all" || cardCategory === category;
        return categoryMatch && cardMatchesSearch(card, normalizedSearch);
      });

      const totalPages = Math.max(1, Math.ceil(matchedCards.length / ACADEMY_LIST_PAGE_SIZE));
      const safePage = Math.min(Math.max(1, page), totalPages);
      const start = (safePage - 1) * ACADEMY_LIST_PAGE_SIZE;

      cards.forEach((card) => card.classList.add("is-hidden"));
      matchedCards.slice(start, start + ACADEMY_LIST_PAGE_SIZE).forEach((card) => {
        card.classList.remove("is-hidden");
      });

      const emptyEl = document.querySelector<HTMLElement>("[data-academy-grid-empty]");
      if (emptyEl) {
        emptyEl.hidden = matchedCards.length > 0;
      }

      activeCategory = category;
      activePage = safePage;
      activeSearch = search;
      setActiveCategoryPill(category);
      renderPagination(safePage, totalPages, category, search);
      syncUrl(safePage, category, search);
    }

    categoryPills.forEach((pill) => {
      pill.addEventListener("click", (event) => {
        event.preventDefault();
        applyListState(1, pill.dataset.academyCategoryFilter ?? "all", activeSearch);
      });
    });

    if (searchForm) {
      searchForm.addEventListener("submit", (event) => {
        event.preventDefault();
        const nextSearch = searchInput?.value ?? "";
        applyListState(1, activeCategory, nextSearch);
      });
    }

    paginationRoot.addEventListener("click", (event) => {
      const target = (event.target as HTMLElement | null)?.closest<HTMLAnchorElement>("[data-academy-page]");
      if (!target) return;
      event.preventDefault();
      applyListState(parseAcademyListPage(target.dataset.academyPage), activeCategory, activeSearch);
    });

    window.addEventListener("popstate", () => {
      const params = new URLSearchParams(window.location.search);
      const nextSearch = parseAcademyListSearch(params);
      if (searchInput) {
        searchInput.value = nextSearch;
      }
      applyListState(
        parseAcademyListPage(params.get("page")),
        parseAcademyListCategory(params),
        nextSearch,
      );
    });

    applyListState(activePage, activeCategory, activeSearch);
  }
</script>
