---
import "../styles/global.css";
import { APERIX_FAVICON_ICO } from "@shared/aperix";
import { cmsMetaToPageSeo, mergePageSeo, resolvePageMeta, type PageSeo } from "@/lib/seo";
import { getPageSeoByPath } from "@/lib/payload";
import {
  getBytedanceAutoIncludeSrc,
  getSiteVerificationMetas,
} from "@/lib/site-verification";
import { siteConfig } from "@site";

type Props = {
  seo?: PageSeo;
  /** schema.org JSON-LD 对象列表，按页注入 */
  jsonLd?: Record<string, unknown>[];
};

const defaultSeo: PageSeo = {
  title: siteConfig.name,
  description: siteConfig.description,
};

const { seo = defaultSeo, jsonLd = [] } = Astro.props;
const cmsPageSeo = await getPageSeoByPath(Astro.url.pathname);
const cmsOverride = cmsMetaToPageSeo(cmsPageSeo?.meta);
let effectiveSeo = mergePageSeo(seo, cmsOverride);
if (cmsPageSeo?.noindex) {
  effectiveSeo = { ...effectiveSeo, noindex: true };
}
const site = Astro.site ?? Astro.url;
const meta = resolvePageMeta(effectiveSeo, site, Astro.url.pathname);
const siteVerifications = getSiteVerificationMetas();
/** noindex 页不推头条自动收录 */
const bytedancePushSrc = effectiveSeo.noindex ? null : getBytedanceAutoIncludeSrc();
const bytedancePushInline = bytedancePushSrc
  ? `(function(){var el=document.createElement("script");el.src=${JSON.stringify(bytedancePushSrc)};el.id="ttzz";var s=document.getElementsByTagName("script")[0];s.parentNode.insertBefore(el,s);})(window)`
  : "";
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href={APERIX_FAVICON_ICO} type="image/x-icon" sizes="any" />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <meta name="keywords" content={meta.keywords} />
    <meta name="application-name" content={meta.siteName} />
    <meta name="robots" content={meta.robots} />
    {
      siteVerifications.map((item) => (
        <meta name={item.name} content={item.content} />
      ))
    }
    <link rel="canonical" href={meta.canonical} />
    <meta property="og:type" content={meta.type} />
    <meta property="og:url" content={meta.canonical} />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:site_name" content={meta.siteName} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:image" content={meta.image} />
    <meta property="og:image:alt" content={meta.imageAlt} />
    <meta property="og:image:width" content={String(meta.imageWidth)} />
    <meta property="og:image:height" content={String(meta.imageHeight)} />
    <meta property="og:image:type" content={meta.imageType} />
    {
      meta.type === "article" && meta.publishedTime && (
        <meta property="article:published_time" content={meta.publishedTime} />
      )
    }
    {
      meta.type === "article" && meta.modifiedTime && (
        <meta property="article:modified_time" content={meta.modifiedTime} />
      )
    }
    {
      meta.type === "article" && meta.authorName && (
        <meta property="article:author" content={meta.authorName} />
      )
    }
    {
      meta.type === "article" && meta.section && (
        <meta property="article:section" content={meta.section} />
      )
    }
    <meta name="apple-mobile-web-app-title" content={meta.siteName} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={meta.title} />
    <meta name="twitter:description" content={meta.description} />
    <meta name="twitter:image" content={meta.image} />
    <meta name="twitter:image:alt" content={meta.imageAlt} />
    {
      jsonLd.map((item) => (
        <script type="application/ld+json" set:html={JSON.stringify(item)} />
      ))
    }
    {bytedancePushSrc && <script is:inline set:html={bytedancePushInline} />}
  </head>
  <body class="bg-background text-foreground flex min-h-svh flex-col">
    <slot />
  </body>
</html>
