---
export const prerender = false;

import BaseLayout from "@/layouts/BaseLayout.astro";
import AboutPage from "@/components/about/AboutPage.astro";
import { aboutSeo } from "@/lib/seo";
import { getAboutPage } from "@/lib/payload";
import "@/styles/style.css";
import "@/styles/about.css";

const cmsAbout = await getAboutPage();
---

<BaseLayout seo={aboutSeo}>
  <AboutPage cmsAbout={cmsAbout ?? {}} />
</BaseLayout>
