---
import BaseLayout from "@/layouts/BaseLayout.astro";
import AboutPage from "@/components/about/AboutPage.astro";
import { mergeAboutStory } from "@/lib/about";
import { aboutSeo } from "@/lib/seo";
import { getPageBySlug } from "@/lib/payload";
import "@/styles/style.css";
import "@/styles/about.css";

const story = mergeAboutStory(await getPageBySlug("about"));
---

<BaseLayout seo={aboutSeo}>
  <AboutPage story={story} />
</BaseLayout>
