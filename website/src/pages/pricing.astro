import PricingPage from "@/components/pricing/PricingPage.astro";
import { getPlanCatalog } from "@/lib/pricing";
import { pricingSeo } from "@/lib/seo";
import "@/styles/style.css";
import "@/styles/pricing.css";

const planCatalog = await getPlanCatalog();
---

<BaseLayout seo={pricingSeo}>
  <PricingPage planCatalog={planCatalog} />
</BaseLayout>
