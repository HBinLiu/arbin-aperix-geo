---
export const prerender = false;

import BaseLayout from "@/layouts/BaseLayout.astro";
import NewsDetailPage from "@/components/news/NewsDetailPage.astro";
import { cmsDocToNewsListItem } from "@/lib/news/cms";
import { buildNewsDetail } from "@/lib/news/detail";
import { getNewsDraftBySlug } from "@/lib/payload";
import { isPreviewRequestAuthorized } from "@/lib/preview";
import { mergeNewsDetailSeo } from "@/lib/seo";
import "@/styles/style.css";
import "@/styles/news/detail.css";

const slug = Astro.params.slug?.trim();
const payloadSecret = Astro.url.searchParams.get("payloadSecret");
const token = Astro.url.searchParams.get("token");

if (!slug || !isPreviewRequestAuthorized(payloadSecret, token)) {
  return new Response("无权预览此页面", { status: 403 });
}

const cmsDoc = await getNewsDraftBySlug(slug, token!);
if (!cmsDoc) {
  return new Response("未找到草稿或预览已失效", { status: 404 });
}

const item = cmsDocToNewsListItem(cmsDoc);
const detail = buildNewsDetail(item, cmsDoc);
const seo = {
  ...mergeNewsDetailSeo(
    {
      title: item.cardTitle,
      description: item.cardDescription,
      slug: item.slug,
    },
    cmsDoc.meta,
  ),
  noindex: true,
};
---

<BaseLayout seo={seo}>
  <div class="news-detail-preview">
    <div
      class="border-b border-amber-200/80 bg-amber-50 px-4 py-2 text-center text-sm text-amber-950"
      role="status"
    >
      预览模式 · 显示草稿内容，尚未发布
    </div>
    <NewsDetailPage detail={detail} />
  </div>
</BaseLayout>
