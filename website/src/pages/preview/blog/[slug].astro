---
export const prerender = false;

import BaseLayout from "@/layouts/BaseLayout.astro";
import BlogDetailPage from "@/components/blog/BlogDetailPage.astro";
import { cmsDocToAuthor } from "@/lib/authors/cms";
import { cmsDocToBlogListItem, mergeBlogList } from "@/lib/blog/cms";
import { buildBlogDetail, pickRelatedBlogPosts } from "@/lib/blog/detail";
import { getAuthorBySlug, getBlogDraftBySlug, getBlogList } from "@/lib/payload";
import { isPreviewRequestAuthorized } from "@/lib/preview";
import { mergeBlogDetailSeo } from "@/lib/seo";
import "@/styles/style.css";
import "@/styles/blog/detail.css";

const slug = Astro.params.slug?.trim();
const payloadSecret = Astro.url.searchParams.get("payloadSecret");
const token = Astro.url.searchParams.get("token");

if (!slug || !isPreviewRequestAuthorized(payloadSecret, token)) {
  return new Response("无权预览此页面", { status: 403 });
}

const cmsDoc = await getBlogDraftBySlug(slug, token!);
if (!cmsDoc) {
  return new Response("未找到草稿或预览已失效", { status: 404 });
}

const item = cmsDocToBlogListItem(cmsDoc);
const authorSlug = item.author?.slug;
const authorCms = authorSlug ? await getAuthorBySlug(authorSlug) : null;
const author = authorCms ? cmsDocToAuthor(authorCms) : null;
const relatedPosts = pickRelatedBlogPosts(item, mergeBlogList(await getBlogList()));

const detail = buildBlogDetail(item, cmsDoc, { author, relatedPosts });
const seo = {
  ...mergeBlogDetailSeo(
    {
      title: item.cardTitle,
      description: item.cardDescription,
      slug: item.slug,
    },
    cmsDoc.meta,
    item.coverUrl,
  ),
  noindex: true,
};
---

<BaseLayout seo={seo}>
  <div class="blog-detail-preview">
    <div
      class="border-b border-amber-200/80 bg-amber-50 px-4 py-2 text-center text-sm text-amber-950"
      role="status"
    >
      预览模式 · 显示草稿内容，尚未发布
    </div>
    <BlogDetailPage detail={detail} />
  </div>
</BaseLayout>
