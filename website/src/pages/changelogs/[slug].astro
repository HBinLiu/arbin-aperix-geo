---
export const prerender = false;

import BaseLayout from "@/layouts/BaseLayout.astro";
import ChangelogDetailPage from "@/components/changelog/ChangelogDetailPage.astro";
import { cmsDocToAuthor, mergeAuthors } from "@/lib/authors/cms";
import { cmsDocToChangelogListItem } from "@/lib/changelog/cms";
import { buildChangelogDetail } from "@/lib/changelog/detail";
import { authorHref } from "@/lib/changelog";
import { buildArticleJsonLd, buildBreadcrumbJsonLd } from "@/lib/json-ld";
import { getAuthorBySlug, getAuthors, getChangelogBySlug } from "@/lib/payload";
import { mergeChangelogDetailSeo, withArticleMeta } from "@/lib/seo";
import { CHANGELOG_RELEASE_TYPE_LABELS } from "@shared/changelog";
import "@/styles/style.css";
import "@/styles/changelog/detail.css";

const slug = Astro.params.slug?.trim();
if (!slug) {
  return new Response(null, { status: 404, statusText: "Not Found" });
}

const cmsDoc = await getChangelogBySlug(slug);
if (!cmsDoc) {
  return new Response(null, { status: 404, statusText: "Not Found" });
}

const item = cmsDocToChangelogListItem(cmsDoc);
const authors = mergeAuthors(await getAuthors());

const authorSlug = item.author?.slug;
const authorCms = authorSlug ? await getAuthorBySlug(authorSlug) : null;
const author =
  (authorCms ? cmsDocToAuthor(authorCms) : null) ??
  authors.find((entry) => entry.slug === authorSlug) ??
  null;

const detail = buildChangelogDetail(item, cmsDoc, { author });

const path = `/changelogs/${item.slug}/`;
const authorName = author?.name || item.author?.name;
const section = CHANGELOG_RELEASE_TYPE_LABELS[item.releaseType] || item.releaseType;
const seo = withArticleMeta(
  mergeChangelogDetailSeo(
    {
      title: item.cardTitle,
      description: item.cardDescription,
      slug: item.slug,
    },
    cmsDoc.meta,
  ),
  {
    publishedTime: item.publishedAt,
    modifiedTime: item.updatedAt || item.publishedAt,
    authorName,
    section,
  },
);

const site = Astro.site ?? Astro.url;
const jsonLd = [
  buildBreadcrumbJsonLd(site, [
    { name: "首页", path: "/" },
    { name: "更新日志", path: "/changelogs/" },
    { name: item.cardTitle, path },
  ]),
  buildArticleJsonLd(site, {
    type: "Article",
    title: item.cardTitle,
    description: item.cardDescription,
    path,
    image: seo.image,
    datePublished: seo.publishedTime,
    dateModified: seo.modifiedTime,
    authorName,
    authorUrl: authorSlug ? authorHref(authorSlug) : undefined,
    section,
  }),
];
---

<BaseLayout seo={seo} jsonLd={jsonLd}>
  <ChangelogDetailPage detail={detail} />
</BaseLayout>
