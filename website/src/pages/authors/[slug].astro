---
export const prerender = false;

import BaseLayout from "@/layouts/BaseLayout.astro";
import AuthorDetailPage from "@/components/authors/AuthorDetailPage.astro";
import { cmsDocToAuthor } from "@/lib/authors/cms";
import { mergeBlogList } from "@/lib/blog/cms";
import { getAuthorBySlug, getBlogList } from "@/lib/payload";
import { mergeAuthorDetailSeo } from "@/lib/seo";
import "@/styles/style.css";
import "@/styles/authors/detail.css";

const slug = Astro.params.slug?.trim();
if (!slug) {
  return new Response(null, { status: 404, statusText: "Not Found" });
}

const cmsDoc = await getAuthorBySlug(slug);
if (!cmsDoc) {
  return new Response(null, { status: 404, statusText: "Not Found" });
}

const author = cmsDocToAuthor(cmsDoc);
const allPosts = mergeBlogList(await getBlogList());
const posts = allPosts.filter((post) => post.author?.slug === author.slug);
const seo = mergeAuthorDetailSeo(author, cmsDoc.meta);
---

<BaseLayout seo={seo}>
  <AuthorDetailPage author={author} posts={posts} />
</BaseLayout>
