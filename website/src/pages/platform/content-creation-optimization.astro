---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ContentPage from "@/components/platform/ContentPage.astro";
import { mergeContentCreationFaqs } from "@/lib/platform/content";
import { platformContentSeo } from "@/lib/seo";
import { buildPlatformFaqJsonLd } from "@/lib/json-ld";
import { getFaqsByPage } from "@/lib/payload";
import { FAQ_PAGE } from "@shared/faq/pages";
import "@/styles/style.css";
import "@/styles/platform/content.css";

const faqs = mergeContentCreationFaqs(
  await getFaqsByPage(FAQ_PAGE.platformContent),
);
const jsonLd = [buildPlatformFaqJsonLd(faqs)];
---

<BaseLayout seo={platformContentSeo} jsonLd={jsonLd}>
  <ContentPage faqs={faqs} />
</BaseLayout>
