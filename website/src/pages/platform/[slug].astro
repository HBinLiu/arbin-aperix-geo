---
import BaseLayout from "@/layouts/BaseLayout.astro";
import MonitorPage from "@/components/platform/MonitorPage.astro";
import { getAllMonitorPages, monitorFaqs } from "@/lib/platform/monitor";
import { buildFaqPageJsonLd } from "@/lib/json-ld";
import "@/styles/style.css";
import "@/styles/platform/monitor.css";

export async function getStaticPaths() {
  return getAllMonitorPages().map((content) => ({
    params: { slug: content.slug },
    props: { content },
  }));
}

const { content } = Astro.props;
const jsonLd = [buildFaqPageJsonLd(monitorFaqs(content.platformId))];
---

<BaseLayout seo={content.seo} jsonLd={jsonLd}>
  <MonitorPage content={content} />
</BaseLayout>
