---
import BaseLayout from "@/layouts/BaseLayout.astro";
import MonitorPage from "@/components/platform/MonitorPage.astro";
import { getAllMonitorPages, mergeMonitorFaqs } from "@/lib/platform/monitor";
import { buildFaqPageJsonLd } from "@/lib/json-ld";
import { getFaqsByPage } from "@/lib/payload";
import { monitorFaqPage, type MonitorFaqSlug } from "@shared/faq/pages";
import "@/styles/style.css";
import "@/styles/platform/monitor.css";

export async function getStaticPaths() {
  return getAllMonitorPages().map((content) => ({
    params: { slug: content.slug },
    props: { content },
  }));
}

const { content } = Astro.props;
const faqs = mergeMonitorFaqs(
  await getFaqsByPage(monitorFaqPage(content.slug as MonitorFaqSlug)),
);
const jsonLd = [buildFaqPageJsonLd(faqs)];
---

<BaseLayout seo={content.seo} jsonLd={jsonLd}>
  <MonitorPage content={content} faqs={faqs} />
</BaseLayout>
