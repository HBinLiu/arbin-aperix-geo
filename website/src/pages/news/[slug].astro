---
export const prerender = false;

import BaseLayout from "@/layouts/BaseLayout.astro";
import NewsDetailPage from "@/components/news/NewsDetailPage.astro";
import { cmsDocToNewsListItem } from "@/lib/news/cms";
import { buildNewsDetail } from "@/lib/news/detail";
import { getNewsBySlug } from "@/lib/payload";
import { mergeNewsDetailSeo } from "@/lib/seo";
import "@/styles/style.css";
import "@/styles/news/detail.css";

const slug = Astro.params.slug?.trim();
if (!slug) {
  return new Response(null, { status: 404, statusText: "Not Found" });
}

const cmsDoc = await getNewsBySlug(slug);
if (!cmsDoc) {
  return new Response(null, { status: 404, statusText: "Not Found" });
}

const item = cmsDocToNewsListItem(cmsDoc);
const detail = buildNewsDetail(item, cmsDoc);
const seo = mergeNewsDetailSeo(
  {
    title: item.cardTitle,
    description: item.cardDescription,
    slug: item.slug,
  },
  cmsDoc.meta,
);
---

<BaseLayout seo={seo}>
  <NewsDetailPage detail={detail} />
</BaseLayout>
