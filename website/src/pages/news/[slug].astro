---
export const prerender = false;

import BaseLayout from "@/layouts/BaseLayout.astro";
import NewsDetailPage from "@/components/news/NewsDetailPage.astro";
import { cmsDocToNewsListItem } from "@/lib/news/cms";
import { buildNewsDetail } from "@/lib/news/detail";
import { buildArticleJsonLd, buildBreadcrumbJsonLd } from "@/lib/json-ld";
import { getNewsBySlug } from "@/lib/payload";
import { mergeNewsDetailSeo, withArticleMeta } from "@/lib/seo";
import "@/styles/style.css";
import "@/styles/news/detail.css";

const slug = Astro.params.slug?.trim();
if (!slug) {
  return new Response(null, { status: 404, statusText: "Not Found" });
}

const cmsDoc = await getNewsBySlug(slug);
if (!cmsDoc) {
  return new Response(null, { status: 404, statusText: "Not Found" });
}

const item = cmsDocToNewsListItem(cmsDoc);
const detail = buildNewsDetail(item, cmsDoc);
const path = `/news/${item.slug}/`;
const seo = withArticleMeta(
  mergeNewsDetailSeo(
    {
      title: item.cardTitle,
      description: item.cardDescription,
      slug: item.slug,
    },
    cmsDoc.meta,
  ),
  {
    publishedTime: item.publishedAt,
    modifiedTime: item.publishedAt,
    authorName: cmsDoc.sourceAuthor,
    section: cmsDoc.tag,
  },
);

const site = Astro.site ?? Astro.url;
const jsonLd = [
  buildBreadcrumbJsonLd(site, [
    { name: "首页", path: "/" },
    { name: "新闻", path: "/news/" },
    { name: item.cardTitle, path },
  ]),
  buildArticleJsonLd(site, {
    type: "NewsArticle",
    title: item.cardTitle,
    description: item.cardDescription,
    path,
    image: seo.image,
    datePublished: seo.publishedTime,
    dateModified: seo.modifiedTime,
    authorName: seo.authorName,
    section: seo.section,
  }),
];
---

<BaseLayout seo={seo} jsonLd={jsonLd}>
  <NewsDetailPage detail={detail} />
</BaseLayout>
