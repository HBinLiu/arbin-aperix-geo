---
import BaseLayout from "@/layouts/BaseLayout.astro";
import NewsDetailPage from "@/components/news/NewsDetailPage.astro";
import { mergeNewsList } from "@/lib/news/cms";
import { buildNewsDetail } from "@/lib/news/detail";
import { getNewsBySlug, getNewsList } from "@/lib/payload";
import { mergeNewsDetailSeo } from "@/lib/seo";
import "@/styles/style.css";
import "@/styles/news/detail.css";

export async function getStaticPaths() {
  const items = mergeNewsList(await getNewsList());

  return items.map((item) => ({
    params: { slug: item.slug },
    props: { item },
  }));
}

const { item } = Astro.props;
const cmsDoc = await getNewsBySlug(item.slug);
const detail = buildNewsDetail(item, cmsDoc);
const seo = mergeNewsDetailSeo(
  {
    title: item.cardTitle,
    description: item.cardDescription,
    slug: item.slug,
  },
  cmsDoc?.meta,
);
---

<BaseLayout seo={seo}>
  <NewsDetailPage detail={detail} />
</BaseLayout>
